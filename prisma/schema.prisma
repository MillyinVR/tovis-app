// Lifecycle of a single (possibly partial) refund against a booking's captured
// Stripe payment. A booking may have several BookingRefund rows (partial
// refunds), so the per-refund state lives here while Booking.stripePaymentStatus
// flips to REFUNDED only once the cumulative refunded amount reaches the total.
enum BookingRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

// What caused a refund to be issued, for audit + reporting.
//   AUTO_CANCELLATION — fired automatically by the cancellation policy
//                       (pro/admin cancel, or client cancel ≥24h out).
//   DISCRETIONARY     — issued explicitly by a pro or admin (the <24h window
//                       and any manual/partial refund).
enum BookingRefundTrigger {
  AUTO_CANCELLATION
  DISCRETIONARY
}

enum BookingCloseoutAuditAction {
  SESSION_STARTED
  SESSION_FINISHED
  SESSION_STEP_CHANGED
  BEFORE_PHOTO_UPLOADED
  AFTER_PHOTO_UPLOADED
  FINAL_REVIEW_CONFIRMED
