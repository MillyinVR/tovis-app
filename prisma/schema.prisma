  // ✅ ADD THESE
  reviewedByAdminId String?
  reviewedByAdmin   User?   @relation(fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  // Retention: the raw file (imageUrl/url) is auto-purged 90 days after
  // reviewedAt by the license-doc-retention sweep, which nulls both URL
  // fields and stamps this. Everything else on the row (type, label, status,
  // reviewedAt, adminNote, reviewedByAdminId) is kept forever as the audit
  // trail — only the raw bytes are deleted.
  fileDeletedAt DateTime?

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id])

  // ✅ ADD INDEXES (admin queue will thank you)
  @@index([professionalId, createdAt])
  @@index([status, createdAt])
  @@index([type, status, createdAt])
  // Retention sweep: reviewed docs whose file hasn't been purged yet.
  @@index([reviewedAt, fileDeletedAt])
}

/// K16 — one pro's booking policy for ONE client. The "difficult clients" half
/// of the release-forms ask, split off deliberately: a judgement about a person
/// must not be modelled as a waiver, because that produces a signed legal
/// artifact encoding that judgement.
///
/// 🔴 EXPLICIT SWITCHES, NEVER FREE TEXT. Anything a pro types about a client is
/// discoverable in a dispute; a boolean is not a characterisation. The pro's own
/// prose about a client already has a home — `ClientProfessionalNote`
/// (DO_NOT_REBOOK carries the reason) — and this table deliberately does not
/// duplicate it. Do not add a `reason` column here.
///
/// Pro-private: scoped to (professionalId, clientId), never shown to the client
/// and never shared with another pro. The CLIENT experiences the effect (a
/// deposit, a card, a closed booking page) but is never told they were flagged —
/// the refusal copy is neutral by construction (lib/proClientPolicy/copy.ts).
///
/// A row exists only when the pro set something. Absent row == every default,
/// which is why the resolver takes `ProClientPolicy | null` and never requires
/// callers to create one first.
/// W5 — the client's CONSENT to a professional seeing their chart.
///
/// Before this, `lib/clientVisibility.ts` treated a bare MessageThread as a
/// reason to open the whole chart, open-ended (`accessUntil: null`), and no
/// consumer branched on the reason — so a single message granted byte-identical
/// read AND write access to notes, allergies, formulas, consent records, photo
/// release, the technical record, service addresses, do-not-rebook, policy and
/// date of birth. Joining a waitlist did it too, because `seedWaitlistThread`
/// auto-creates a thread: a client who never messaged anyone handed over their
/// whole chart by tapping "notify me".
///
/// A thread now grants CONTACT only. Full chart access needs either a
/// qualifying booking (unchanged — a client who books has consented to being
/// treated) or a GRANTED row here.
///
/// 🔴 The state machine is deliberately one row per pair, not an append-only
/// log: the question "may this pro see this chart right now" must have exactly
/// one answer. `revokedAt`/`respondedAt`/`requestedAt` keep the history that
/// matters on the row itself.
model ClientChartShare {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId       String
  professionalId String

  status ClientChartShareStatus

  /// When the PRO asked. Null when the client granted unprompted.
  requestedAt DateTime?
  /// When the client answered — granted or declined.
  respondedAt DateTime?
  /// When the client took it back. Kept alongside GRANTED history so a revoke
  /// is legible as an act, not just an absence.
  revokedAt   DateTime?

  client       ClientProfile       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  /// One share per (client, pro). A second row would make "is it shared"
  /// ambiguous on a path that reads a medical record.
  @@unique([clientId, professionalId])
  /// The pro's side: "who has granted me access", and their open requests.
  @@index([professionalId, status])
  /// The client's side: the revoke list in /client/settings.
  @@index([clientId, status])
}

enum ClientChartShareStatus {
  /// The pro asked; the client has not answered. Grants NOTHING.
  REQUESTED
  /// The client said yes. This is the only value that opens the chart.
  GRANTED
  /// The client said no. Distinct from REVOKED so a pro cannot re-ask by
  /// waiting out an absent row, and so "declined" is not read as "never asked".
  DECLINED
  /// The client granted, then took it back.
  REVOKED
}

model ProClientPolicy {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professionalId String
  clientId       String

  /// Take a deposit from THIS client whatever the account-wide
  /// `ProfessionalPaymentSettings.depositScope` says. Read by
  /// `resolveDepositRequirement` as a fourth reason a booking owes money up
  /// front — it widens the deposit, never the platform discovery fee, which
  /// stays pinned to the new-via-discovery subset.
  requireDeposit Boolean @default(false)

  /// Prepay (pay in full up front) for THIS client, at this scope. Null = no
  /// per-client prepay requirement.
  ///
  /// Modelled exactly like `ProfessionalServiceOffering.prepayScope`: the scope
  /// column IS the switch. A separate `requirePrepay` boolean beside a nullable
  /// scope would be two columns encoding one fact, and the pair can disagree
  /// (see [[optional-field-hides-a-required-one]]). The pro picks the scope
  /// (Tori, 2026-07-31); when both this and the offering's requirement apply,
  /// the WIDER scope wins and the money terms take max, never a sum.
  prepayScope OfferingPrepayScope?

  /// Require a saved card before this client can book. Enforced at finalize,
  /// with an inline add-card step in the booking flow (Tori, 2026-07-31).
  ///
  /// 🔴 Gated on `noShowProtectionEnabled()` — the card-on-file rail
  /// (setup-intent route + the save-card surface) is dark behind
  /// ENABLE_NO_SHOW_PROTECTION. Offering a requirement whose only means of
  /// compliance 404s is an offered option that cannot be accepted, so the pro
  /// cannot SET this while the rail is dark and the gate no-ops if a stored row
  /// says otherwise.
  requireCardOnFile Boolean @default(false)

  /// This client cannot book a NEW appointment themselves. Refuses hold
  /// creation and the aftercare-rebook token path (Tori, 2026-07-31).
  ///
  /// 🔴 Deliberately does NOT refuse: rescheduling an appointment that already
  /// exists, or confirming a waitlist offer the pro explicitly sent. Both are
  /// appointments the pro already agreed to; blocking them would strand a
  /// confirmed booking and 400 the Reschedule button in K12's own reminder.
  /// Pro-created bookings are untouched — the pro can always book them by hand.
  blockSelfServeBooking Boolean @default(false)

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  client       ClientProfile       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// One policy per (pro, client) pair — the resolver reads at most one row, and
  /// a second row would make "the policy" ambiguous on a money path.
  @@unique([professionalId, clientId])
  @@index([professionalId, updatedAt])
}

// ✅ Pro-to-pro shared feedback about a client.
// Use this for: “notes/reviews for the client from pros who serviced them in the past”.
model ClientProfessionalNote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Who this is about + who wrote it
  clientId       String
  professionalId String

  // Optional: tie feedback to the appointment it came from (strongly recommended)
  // If the booking is deleted, we still want the feedback to remain, so SetNull.
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  // Content
  title String?
  body  String

  // AEAD-encrypted envelopes for the free-text content (expand→contract dual-write;
  // see docs/security/ticket-encrypt-tier3-health-notes.md). Plaintext columns above
  // remain during burn-in and are dropped in the contract migration.
  titleEncrypted Json?
  bodyEncrypted  Json?

  // Optional “review-like” rating (1–5). Keep optional so it can stay a note.
  rating Int?

  // What kind of professional-memory entry this is (grouped on the chart).
  // DO_NOT_REBOOK entries are author-scoped (PRIVATE_TO_AUTHOR) by construction.
  kind ClientNoteKind @default(GENERAL)

  // Who can see it
  visibility ClientNoteVisibility @default(PROFESSIONALS_ONLY)

  // Relations
  client       ClientProfile       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  // Prevent duplicates for the same booking+author (optional but helpful).
  // Allows multiple notes not tied to a booking.
  @@unique([professionalId, bookingId])
  @@index([clientId, createdAt])
  @@index([professionalId, createdAt])
  @@index([professionalId, clientId, kind])
  @@index([bookingId])
}

// Pro-authored craft record, per visit. Default PRIVATE_TO_AUTHOR and NEVER
// public (formula text never leaves the authoring pro). Persists beyond the
// 30-day ambient window (two-tier retention; retention = indefinite for now).
// PR4 — flagged (ENABLE_CLIENT_TECHNICAL_RECORD); legal-gated track.
model ClientFormulaEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId       String
  professionalId String
  bookingId      String?

  // Structured craft fields (plaintext). Free-text result/notes are encrypted.
  brand                 String?
  developer             String?
  ratio                 String?
  processingTimeMinutes Int?
  resultNotesEncrypted  Json?

  // Always author-scoped; never public.
  visibility ClientNoteVisibility @default(PRIVATE_TO_AUTHOR)

  client       ClientProfile       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  booking      Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([professionalId, clientId, createdAt])
  @@index([clientId, createdAt])
  @@index([bookingId])
}

// K14 — a consent/waiver form a pro can put in front of a client.
//
// A form is IDENTITY + ownership only; everything a client would ever read
// (title AND body) lives on its append-only versions, because a record that
// snapshots the body but lets the heading be rewritten later is not defensible
// either. The current text is simply the highest-numbered version.
//
// Ownership:
//   * professionalId NULL  → a PLATFORM template, adoptable by any pro.
//     Created only by an admin (POST /api/v1/admin/consent-forms); the platform
//     TEXT is a legal deliverable (D6), not something this code invents.
//   * professionalId SET   → a pro's own form. `sourceTemplateId` records that
//     it was adopted from a platform template; per-version
//     `verbatimFromTemplate` records whether that pro then CHANGED the words.
//     Origin is derived from these two columns (lib/consentForms/origin.ts) and
//     deliberately not stored a third time.
model ConsentForm {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NULL = platform-owned template.
  professionalId String?
  kind           ClientConsentKind

  // Retire a form without touching history: existing signatures keep resolving
  // their version forever. Never delete a form that has been signed.
  isActive Boolean @default(true)

  // Set when a pro adopted a platform template into their own library.
  sourceTemplateId String?

  professional   ProfessionalProfile? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  sourceTemplate ConsentForm?         @relation("ConsentFormTemplateAdoptions", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  adoptions      ConsentForm[]        @relation("ConsentFormTemplateAdoptions")
  versions       ConsentFormVersion[]

  // K15 — the services that require this form to be signed.
  requiredByOfferings ProfessionalServiceOffering[] @relation("OfferingConsentRequirement")

  @@index([professionalId, kind, isActive])
  @@index([sourceTemplateId])
}

// K14 — one published revision of a consent form. APPEND-ONLY, enforced by the
// database: migration 20260822000000 installs a BEFORE UPDATE trigger that
// raises on every row, so a pro editing their waiver can never change what an
// already-signed record says. Editing publishes version n+1; signatures keep
// pointing at the version they were made against, forever. Same rule
// Booking.cancellationPolicySnapshot enforces one floor down — different
// mechanism (a shared row, not a per-booking JSON copy) because one version is
// signed by many clients and carries the full text.
//
// `body` is PLAIN TEXT, not markdown: nothing in this repo renders markdown, and
// an HTML-rendering path over pro-authored legal text is an XSS surface nobody
// asked for. Rendered with white-space: pre-wrap.
model ConsentFormVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  formId  String
  version Int
  title   String
  body    String

  publishedAt               DateTime @default(now())
  // NULL = published by the platform (an admin), not by a pro.
  publishedByProfessionalId String?

  // Provenance (D6). Which platform-template version this text came from, and
  // whether it is that text VERBATIM — computed at publish by comparing the
  // words themselves, never taken from the client.
  sourceTemplateVersionId String?
  verbatimFromTemplate    Boolean @default(false)

  form                  ConsentForm           @relation(fields: [formId], references: [id], onDelete: Cascade)
  sourceTemplateVersion ConsentFormVersion?   @relation("ConsentFormVersionTemplateSource", fields: [sourceTemplateVersionId], references: [id], onDelete: SetNull)
  derivedVersions       ConsentFormVersion[]  @relation("ConsentFormVersionTemplateSource")
  consentRecords        ClientConsentRecord[]
  // K15 — the signature links minted against THIS version's words.
  signatureTokens       ClientActionToken[]   @relation("ConsentSignatureTokenVersion")

  @@unique([formId, version])
  @@index([sourceTemplateVersionId])
}

// Consent/waiver + patch-test record. The signed artifact (proof) stays
// author-scoped; patch-test SAFETY fields (result + validity) travel to any pro
// with chart access per the design access matrix. PR4 — flagged, legal-gated.
model ClientConsentRecord {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId       String
  professionalId String // author of the record / holder of the signed artifact
  bookingId      String?

  kind         ClientConsentKind
  serviceScope String? // e.g. "color services", "lash extensions"

  // K14 — the exact text this record attests to. NULLABLE on purpose: every row
  // written before K14 is free-text-only (serviceScope + encrypted notes, no
  // form at all), and those rows must keep reading. A record that HAS one is
  // pinned to that version forever — Restrict, because deleting the text out
  // from under a signature is the failure this whole model exists to prevent.
  formVersionId String?

  // Signature / proof capture (mirrors the clientActionToken/proof pattern; the
  // reference is a soft snapshot id, author-scoped — not surfaced to other pros).
  signedAt    DateTime?
  proofMethod ConsentProofMethod?
  proofRef    String?

  // K15 — the signature link the CLIENT used, when this record was written by
  // the platform rather than typed in by the pro. 🔴 UNIQUE: one signature per
  // link, enforced by the database, so a double-submitted form cannot become
  // two records attesting to the same act. Its presence is also what makes
  // `proofMethod = CLIENT_TOKEN` truthful — the pro can no longer claim it by
  // hand (K14-B), because only the signing route writes this pair.
  //
  // SetNull, never Cascade: deleting the link must not delete the signature.
  // The record is the artifact; the token was only the doorway.
  signatureTokenId String? @unique

  // Patch-test safety fields (travel to any pro with access).
  patchTestResult PatchTestResult?
  validUntil      DateTime?

  // Free-text notes (encrypted).
  notesEncrypted Json?

  visibility ClientNoteVisibility @default(PRIVATE_TO_AUTHOR)

  client         ClientProfile       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  booking        Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  formVersion    ConsentFormVersion? @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  signatureToken ClientActionToken?  @relation("ConsentSignatureTokenRecord", fields: [signatureTokenId], references: [id], onDelete: SetNull)

  @@index([professionalId, clientId, createdAt])
  @@index([clientId, kind, validUntil])
  @@index([bookingId])
  @@index([formVersionId])
}

model Review {
  id             String   @id @default(cuid())
  clientId       String
  professionalId String
  bookingId      String?
  rating         Int
  headline       String?
  body           String?
  createdAt      DateTime @default(now())

  // Single public response from the reviewed pro (edit overwrites; delete
  // clears both). Rendered under the review on every review surface.
  proReplyBody String?
  proReplyAt   DateTime?

  // Admin soft-moderation. A hidden review keeps its row but disappears from
  // review lists and rating aggregates (filter via lib/reviews/visibility.ts);
  // the author still sees it on their own booking. Unhide clears all three.
  hiddenAt            DateTime?
  hiddenByAdminUserId String?
  hiddenReason        String?

  idempotencyKey String?
  requestId      String?

  client       ClientProfile       @relation(fields: [clientId], references: [id])
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id])
  booking      Booking?            @relation(fields: [bookingId], references: [id])

  mediaAssets MediaAsset[]

  notifications Notification[]
  helpfulCount  Int             @default(0)
  helpfulVotes  ReviewHelpful[]

  @@unique([bookingId, idempotencyKey])
  @@index([professionalId, createdAt])
  @@index([clientId, createdAt])
  @@index([bookingId, createdAt])
}

model ClientAllergy {
  id                       String          @id @default(cuid())
  clientId                 String
  label                    String
  description              String?
  severity                 AllergySeverity @default(MODERATE)
  recordedByProfessionalId String?
  createdAt                DateTime        @default(now())

  // AEAD-encrypted envelopes for the health-adjacent free text (expand→contract
  // dual-write; see docs/security/ticket-encrypt-tier3-health-notes.md).
  labelEncrypted       Json?
  descriptionEncrypted Json?

  client     ClientProfile        @relation(fields: [clientId], references: [id])
  recordedBy ProfessionalProfile? @relation(fields: [recordedByProfessionalId], references: [id])

  @@index([clientId])
}

model Reminder {
  id             String       @id @default(cuid())
  professionalId String
  clientId       String?
  bookingId      String?
  type           ReminderType @default(GENERAL)
  title          String
  body           String?
  dueAt          DateTime
  createdAt      DateTime     @default(now())
  completedAt    DateTime?

  dedupeKey String? @unique

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id])
  client       ClientProfile?      @relation(fields: [clientId], references: [id])
  booking      Booking?            @relation(fields: [bookingId], references: [id])

  @@index([professionalId, dueAt])
  @@index([clientId, dueAt])
}

// =======================
// MEDIA MODELS
// =======================

model MediaAsset {
  id               String              @id @default(cuid())
  professionalId   String
  // Tenant of the owning pro (derived from professional.homeTenantId).
  // Expand phase: nullable + backfilled; a follow-up contract migration makes
  // it NOT NULL. See finish-plan T2.2.
  proTenantId      String?
  bookingId        String?
  reviewId         String?
  // Opt-in before/after pairing: on the *displayed* asset (the "after" a pro
  // features to portfolio, or the after-photo of a review), points at the
  // chosen "before" counterpart so surfaces can render the comparison slider
  // (BeforeAfterReveal / BeforeAfterCompareView). Null = show as a single tile.
  // Self-relation, nullable; onDelete SetNull so deleting a before never
  // cascades to the after that references it.
  beforeAssetId    String?
  // Every media asset is anchored to a primary bookable service so it can always
  // route to "book this" (the product goal: media → easy booking). Required by
  // DB constraint + by the MediaAssetWriteInput type (single create choke point,
  // lib/media/recordMediaAsset.ts). Derived at creation from booking.serviceId
  // (session/review photos) or the first selected service (portfolio uploads).
  // Extra/secondary services still live in the MediaServiceTag M2M below.
  // (License/verification docs are NOT MediaAssets — they use VerificationDocument.)
  primaryServiceId String
  uploadedByUserId String?
  uploadedByRole   Role?
  url              String?
  thumbUrl         String?
  mediaType        MediaType
  caption          String?
  // Normalized focal point of the subject (a face, per C6) in the original,
  // EXIF-corrected upright image — both in [0,1] from the TOP-LEFT origin. Lets
  // cover-cropped surfaces (the full-screen Looks feed above all) center their
  // visible window on the subject via CSS `object-position` / SwiftUI UnitPoint
  // instead of the blind geometric center. Null = center = pre-C6 behavior, so
  // legacy rows and every surface render byte-identically until a focal is set.
  // Written at the media-confirm choke point (lib/media/recordMediaAsset.ts).
  focalX           Float?
  focalY           Float?
  createdAt        DateTime            @default(now())
  intentEvents     ClientIntentEvent[]

  lookPostPrimaryFor LookPost[]      @relation("PrimaryLookMediaAsset")
  lookPostAssets     LookPostAsset[] @relation("LookPostAssetMedia")

  visibility            MediaVisibility @default(PUBLIC)
  isFeaturedInPortfolio Boolean         @default(false)
  isEligibleForLooks    Boolean         @default(false)
  reviewLocked          Boolean         @default(false)

  professional              ProfessionalProfile   @relation(fields: [professionalId], references: [id])
  proTenant                 Tenant?               @relation("TenantMediaAssets", fields: [proTenantId], references: [id], onDelete: Restrict)
  booking                   Booking?              @relation(fields: [bookingId], references: [id])
  review                    Review?               @relation(fields: [reviewId], references: [id])
  beforeAsset               MediaAsset?           @relation("MediaBeforeAfterPair", fields: [beforeAssetId], references: [id], onDelete: SetNull)
  pairedAsAfter             MediaAsset[]          @relation("MediaBeforeAfterPair")
  // Back-relation for a practice shot that was later attached (promoted) into
  // this asset. onDelete SetNull on the owning side, so deleting the attached
  // media leaves the practice shot in the library rather than cascading.
  attachedFromPractice      PracticeShot[]        @relation("PracticeShotAttachedMedia")
  // Back-relations for the aftercare "featured pair" (which before/after this
  // asset is the pro-chosen primary of, per AftercareSummary). Aftercare-only,
  // stays PRO_CLIENT — never touches portfolio featuring/visibility.
  featuredInAftercareBefore AftercareSummary[]    @relation("AftercareFeaturedBefore")
  featuredInAftercareAfter  AftercareSummary[]    @relation("AftercareFeaturedAfter")
  // Back-relation for the pro-profile cover banner (§18): which pro profiles use
  // this asset as their cover. onDelete SetNull on the owning side clears it.
  coverForProfiles          ProfessionalProfile[] @relation("ProfessionalCoverMedia")
  primaryService            Service               @relation("MediaPrimaryService", fields: [primaryServiceId], references: [id])
  phase                     MediaPhase            @default(OTHER)
  uploadedByUser            User?                 @relation("UploadedMedia", fields: [uploadedByUserId], references: [id])

  services MediaServiceTag[]
  likes    MediaLike[]
  comments MediaComment[]

  expenseReceipts ProfessionalExpense[]      @relation("ExpenseReceipt")
  receiptInbox    ProfessionalReceiptInbox[] @relation("ReceiptInboxMedia")

  waitlistEntries WaitlistEntry[]

  storageBucket String // 'media-public' | 'media-private'
  storagePath   String
  thumbBucket   String?
  thumbPath     String?

  // One MediaAsset per stored object. Prevents duplicate/orphaned rows pointing
  // at the same upload (e.g. a retried attach). Upload pointers are minted
  // server-side with timestamped/random paths, so legitimate rows never collide.
  @@unique([storageBucket, storagePath])
  @@index([professionalId, createdAt])
  @@index([professionalId, isEligibleForLooks, createdAt])
  @@index([professionalId, isFeaturedInPortfolio, createdAt])
  @@index([uploadedByUserId, createdAt])
  @@index([bookingId, phase, createdAt])
  @@index([bookingId, createdAt])
  @@index([proTenantId])
  @@index([primaryServiceId])
  @@index([beforeAssetId])
}

// UploadSession binds a server-minted signed-upload URL to the eventual
// MediaAsset it produces (finish-plan T2.1 / Phase 4). The signing routes create
// a PENDING session and return its id; the media-attach routes look the session
// up by id, validate it (owner / booking / phase / expiry / status), create the
// MediaAsset from the session's authoritative storage pointer, and mark the
// session CONSUMED. This closes two gaps: the client can no longer assert the
// storage path on attach (the server owns it), and orphaned objects (bytes
// uploaded but never attached) are discoverable as stale PENDING sessions for a
// cleanup job to reap.
//
// Context ids are snapshot columns (no FK relations), matching the booking
// attribution philosophy — they record who/what the upload was for at sign time.
enum UploadSurface {
  PRO_BOOKING_MEDIA
  PRO_LOOKS
  PRO_PORTFOLIO
  CLIENT_REVIEW
  // Client publishes a look from their visit (Share-your-look capture). Uploads
  // land in media-public (the client consents to a public-intent look asset),
  // optionally carrying a BEFORE/AFTER phase.
  CLIENT_LOOK
  // A pro shooting OUTSIDE a session (the standalone camera). Lands in
  // media-private and produces a PracticeShot, not a MediaAsset — a practice
  // shot has no booking and no service anchor, so it is deliberately not a
  // MediaAsset until the pro attaches it to one.
  PRO_PRACTICE
  // Reserved by C1 but intentionally unwired. Any future consult uploader must
  // first require active consent + 18+, use expiring private storage, and prove
  // raw-object purge. This enum value alone authorizes no capture/persistence.
  CLIENT_CONSULT
}

enum UploadSessionStatus {
  PENDING
  CONSUMED
  EXPIRED
}

model UploadSession {
  id      String              @id @default(cuid())
  surface UploadSurface
  status  UploadSessionStatus @default(PENDING)

  // Context snapshot (who/what this upload is for). Nullable because not every
  // surface knows every dimension at sign time (e.g. client review uploads only
  // know the client until the review is attached).
  tenantId       String?
  professionalId String?
  clientId       String?
  bookingId      String?
  phase          MediaPhase?

  // Authoritative storage pointer minted by the signing route. NEVER supplied by
  // the client on attach — the attach route reads it back from here.
  storageBucket  String
  storagePath    String
  contentType    String
  maxBytes       Int
  checksumSha256 String?

  // Lifecycle.
  expiresAt    DateTime
  consumedAt   DateTime?
  mediaAssetId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storageBucket, storagePath])
  @@index([status, expiresAt])
  @@index([professionalId])
  @@index([clientId])
  @@index([bookingId])
}

// A shot the pro took OUTSIDE a session — the standalone camera behind the pro
// footer's centre button when no booking is live.
//
// Deliberately NOT a MediaAsset. Every MediaAsset is anchored to a bookable
// `primaryServiceId` "so it can always route to book this", and a practice shot
// has no service and no booking by definition; giving it a made-up anchor would
// make it show up in every by-service media query. So practice shots live in
// their own table, in the private bucket, invisible to the portfolio/Looks/
// chart surfaces by construction — and become a real MediaAsset only when the
// pro ATTACHES one to a booking or publishes it as a look, which is exactly the
// moment a service is actually known.
//
// Custody semantics: no booking, nothing owed. Nothing anywhere blocks on a
// practice shot existing or being attached.
model PracticeShot {
  id             String  @id @default(cuid())
  professionalId String
  proTenantId    String?

  // Authoritative storage pointer, copied from the consumed UploadSession —
  // never asserted by the client (same rule as the MediaAsset attach routes).
  storageBucket String
  storagePath   String
  contentType   String
  mediaType     MediaType @default(IMAGE)

  caption String?

  // Normalized subject focal point (camera C6) in the EXIF-corrected upright
  // image, both [0,1] from the top-left. Carried through to the MediaAsset if
  // this shot is ever attached. Null = center.
  focalX Float?
  focalY Float?

  // Set once this shot has been promoted into a real MediaAsset (attach-later).
  // The practice row is KEPT after attaching — the pro's library still shows the
  // shot, now marked as used — so this is a pointer, not a tombstone.
  attachedMediaId String?
  attachedAt      DateTime?

  createdAt DateTime @default(now())

  professional  ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  proTenant     Tenant?             @relation("TenantPracticeShots", fields: [proTenantId], references: [id], onDelete: Restrict)
  attachedMedia MediaAsset?         @relation("PracticeShotAttachedMedia", fields: [attachedMediaId], references: [id], onDelete: SetNull)

  // One practice shot per stored object (mirrors the MediaAsset rule) so a
  // retried confirm can never mint two rows over the same bytes.
  @@unique([storageBucket, storagePath])
  @@index([professionalId, createdAt])
  @@index([proTenantId])
  @@index([attachedMediaId])
}

model MediaServiceTag {
  id        String @id @default(cuid())
  mediaId   String
  serviceId String

  // Cascade: a tag is a pure join — it cannot outlive its media, and a Restrict
  // here made EVERY MediaAsset undeletable (the create requires >=1 tag), which
  // broke the pro's "Delete media" button and user-data deletion alike.
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  service Service    @relation(fields: [serviceId], references: [id])

  @@unique([mediaId, serviceId])
}

model MediaLike {
  id        String   @id @default(cuid())
  mediaId   String
  userId    String
  createdAt DateTime @default(now())

  // Cascade: a like on a deleted photo has nothing to point at.
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id])

  @@unique([mediaId, userId])
}

model MediaComment {
  id        String   @id @default(cuid())
  mediaId   String
  userId    String
  body      String
  createdAt DateTime @default(now())

  // Cascade: a comment on a deleted photo has nothing to point at.
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id])
}

model LookPost {
  id                  String  @id @default(cuid())
  // professionalId is the ORIGIN pro of the look (the pro whose work it shows /
  // who is tagged). For pro-authored looks this is also the author. For
  // client-authored looks (clientAuthorId set) it stays the visited pro, so the
  // existing pro-keyed indexes/relations are unchanged. Pro-facing portfolio
  // queries must filter `clientAuthorId: null` to exclude client-authored looks.
  professionalId      String
  // Null = pro-authored (today's behavior). Set = the client who published this
  // look from their visit (engagement loop / Share-your-look capture).
  clientAuthorId      String?
  primaryMediaAssetId String  @unique
  serviceId           String?

  caption         String?
  priceStartingAt Decimal? @db.Decimal(10, 2)

  status           LookPostStatus     @default(DRAFT)
  visibility       LookPostVisibility @default(PUBLIC)
  moderationStatus ModerationStatus   @default(APPROVED)
  // Client-authored discovery gate (social-first C2). For client-authored looks
  // (clientAuthorId set) this must be true before the look enters the public
  // discovery feed — an explicit per-look opt-in, independent of the author's
  // ClientProfile.isPublicProfile. Pro-authored looks are admitted by
  // buildLooksFeedWhere via `clientAuthorId: null` and ignore this flag (it stays
  // false for them). See lib/looks/feed.ts + clientLookService.ts.
  publicToFeed     Boolean            @default(false)

  publishedAt DateTime?
  archivedAt  DateTime?
  removedAt   DateTime?

  reviewedAt       DateTime?
  reviewedByUserId String?
  adminNotes       String?
  reportCount      Int       @default(0)

  // Admin editorial curation (social-first AM1). featuredAt != null = a
  // SUPER_ADMIN promoted this look into the Spotlight feed — an honest editorial
  // signal (see buildLookPostSpotlightEligibilityWhere), never a faked engagement
  // count. featuredByUserId is a plain admin User id (no relation, #481 audit
  // convention, matches Review.hiddenByAdminUserId).
  featuredAt       DateTime?
  featuredByUserId String?

  likeCount    Int @default(0)
  commentCount Int @default(0)
  saveCount    Int @default(0)
  shareCount   Int @default(0)
  // Sampled/denormalized view total (feed impressions + detail opens). Written
  // only by the APPLY_LOOK_VIEWS LooksSocialJob — never a synchronous insert on
  // the view hot path. Social-first plan B2.
  viewCount    Int @default(0)

  spotlightScore Float @default(0)
  rankScore      Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professional      ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  clientAuthor      ClientProfile?      @relation("ClientAuthoredLooks", fields: [clientAuthorId], references: [id], onDelete: Cascade)
  // Cascade: primaryMediaAssetId is required AND @unique, so a look is 1:1 with
  // its primary photo and cannot render without it. Restrict was unworkable: §19b
  // makes EVERY public asset a LookPost, so it meant no public media could ever be
  // deleted — not by the pro, not by user-data deletion. Everything below LookPost
  // (likes, comments, board items, stats) already cascades, so this is the same
  // contract one level up. Deleting a photo deletes its post.
  primaryMediaAsset MediaAsset          @relation("PrimaryLookMediaAsset", fields: [primaryMediaAssetId], references: [id], onDelete: Cascade)
  service           Service?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  reviewedByUser    User?               @relation("LookPostReviewedByUser", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  assets                LookPostAsset[]
  likes                 LookLike[]
  // Per-viewer "not for me" hides (spec §2.2). An explicit, reversible negative
  // signal: a hidden look is excluded from that viewer's feeds, and repeated
  // hides in a category apply a decayed category-level suppression. See
  // lib/looks/hides.ts + lib/looks/personalizedFeed.ts.
  hides                 LookHide[]
  comments              LookComment[]
  reports               LookPostReport[]
  boardItems            BoardItem[]
  // §6.0 visual embedding of the primary image (written by the
  // EMBED_LOOK_POST_IMAGE job; absent until the look is embedded).
  embedding             LookPostEmbedding?
  // §5.6 per-source, per-day impression aggregates (written by the
  // APPLY_LOOK_VIEWS job); the anti-gaming velocity-check denominator breakdown.
  impressionStats       LookPostImpressionStat[]
  // §4.6 per-viewer feed-exposure counts (written by the APPLY_LOOK_VIEWS job);
  // once a viewer has seen a look enough times it's capped out of their feed.
  viewerImpressionStats LookViewerImpressionStat[]
  inspiredBookings      Booking[]                  @relation("LookInspiredBookings")
  // §4.2 per-look booking-conversion aggregate (written hourly by the
  // look-conversion-stats job; absent until the look has driven >=1 booking).
  conversionStat        LookPostConversionStat?
  // User-facing hashtags / style tags parsed from the caption at publish
  // (social-first D1). Implicit M2M; banned tags are dropped at publish and
  // their tag pages 404. See lib/looks/tags.ts.
  tags                  LookTag[]                  @relation("LookPostTags")

  @@index([professionalId, publishedAt])
  @@index([serviceId, publishedAt])
  @@index([status, visibility, publishedAt])
  @@index([moderationStatus, publishedAt])
  @@index([rankScore, publishedAt])
  @@index([spotlightScore, publishedAt])
  @@index([moderationStatus, reportCount, createdAt])
  @@index([reviewedByUserId, reviewedAt])
  @@index([featuredAt])
  @@index([professionalId, status, updatedAt])
  @@index([professionalId, visibility, updatedAt])
  @@index([clientAuthorId, status, updatedAt])
  @@index([clientAuthorId, visibility, publishedAt])
}

// User-facing hashtag / style tag for Looks (social-first D1). `slug` is the
// normalized key (lowercase, ascii, hyphenless) parsed from a caption's #tags;
// `display` is the first-seen human form. A banned tag (bannedAt set) is dropped
// at publish and its /looks/tags/[slug] page 404s. Tag → LookPost is an implicit
// M2M (join table _LookPostTags). See lib/looks/tags.ts.
model LookTag {
  id        String     @id @default(cuid())
  slug      String     @unique
  display   String
  bannedAt  DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  looks     LookPost[] @relation("LookPostTags")

  @@index([bannedAt])
}

model LookPostAsset {
  id           String   @id @default(cuid())
  lookPostId   String
  mediaAssetId String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  lookPost   LookPost   @relation(fields: [lookPostId], references: [id], onDelete: Cascade)
  // Cascade: drops just this asset's row from the look (the look itself survives
  // unless the deleted asset was its PRIMARY — see LookPost.primaryMediaAsset).
  mediaAsset MediaAsset @relation("LookPostAssetMedia", fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([lookPostId, mediaAssetId])
  @@index([lookPostId, sortOrder])
  @@index([mediaAssetId])
}

model LookLike {
  id         String   @id @default(cuid())
  lookPostId String
  userId     String
  createdAt  DateTime @default(now())

  lookPost LookPost @relation(fields: [lookPostId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lookPostId, userId])
  @@index([lookPostId, createdAt])
  @@index([userId, createdAt])
}

// Per-viewer explicit "not for me" hide (spec §2.2). One row = this user does
// not want to see this look. Unambiguous, reversible negative signal (unlike an
// inferred skip): the look is excluded from that viewer's personalized,
// chronological, and board feeds, and — after repeated hides in a category — the
// category is down-ranked by a DECAYED penalty (guardrail #10, no permanent
// invisible penalty; the decay lives in lib/looks/personalizedFeed.ts). Shape
// mirrors LookLike (per-user, unique per look) so the read/exclusion paths reuse
// the same patterns. createdAt is the decay input.
model LookHide {
  id         String   @id @default(cuid())
  lookPostId String
  userId     String
  createdAt  DateTime @default(now())

  lookPost LookPost @relation(fields: [lookPostId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lookPostId, userId])
  @@index([lookPostId, createdAt])
  @@index([userId, createdAt])
}

model LookComment {
  id               String           @id @default(cuid())
  lookPostId       String
  userId           String
  // Null = top-level comment. Set = a reply. Threading is flattened to a single
  // level (TikTok/Instagram style): a reply's parent is always a top-level
  // comment, so there are no replies-of-replies — the create path re-roots any
  // reply aimed at another reply to its top-level ancestor.
  parentCommentId  String?
  body             String
  moderationStatus ModerationStatus @default(APPROVED)
  likeCount        Int              @default(0)
  replyCount       Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  removedAt        DateTime?
  reviewedAt       DateTime?
  reviewedByUserId String?
  adminNotes       String?
  reportCount      Int              @default(0)

  lookPost       LookPost            @relation(fields: [lookPostId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentComment  LookComment?        @relation("LookCommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies        LookComment[]       @relation("LookCommentReplies")
  reviewedByUser User?               @relation("LookCommentReviewedByUser", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reports        LookCommentReport[]
  likes          LookCommentLike[]

  @@index([lookPostId, createdAt])
  @@index([lookPostId, parentCommentId, createdAt])
  @@index([parentCommentId, createdAt])
  @@index([userId, createdAt])
  @@index([moderationStatus, createdAt])
  @@index([moderationStatus, reportCount, createdAt])
  @@index([reviewedByUserId, reviewedAt])
}

model LookCommentLike {
  id            String   @id @default(cuid())
  lookCommentId String
  userId        String
  createdAt     DateTime @default(now())

  lookComment LookComment @relation(fields: [lookCommentId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lookCommentId, userId])
  @@index([lookCommentId, createdAt])
  @@index([userId, createdAt])
}

model LookPostReport {
  id               String                 @id @default(cuid())
  lookPostId       String
  userId           String
  reason           ModerationReportReason @default(OTHER)
  createdAt        DateTime               @default(now())
  // Report resolution (social-first AM1 moderation queue). resolvedAt != null =
  // a SUPER_ADMIN reviewed this report and dismissed it (kept the look live) or
  // acted on the look; unresolved reports drive the moderation queue's Reported
  // view. resolvedByUserId is a plain admin User id (no relation, #481 convention).
  resolvedAt       DateTime?
  resolvedByUserId String?

  lookPost LookPost @relation(fields: [lookPostId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lookPostId, userId])
  @@index([lookPostId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([reason, createdAt])
  @@index([resolvedAt, createdAt])
}

model LookCommentReport {
  id               String                 @id @default(cuid())
  lookCommentId    String
  userId           String
  reason           ModerationReportReason @default(OTHER)
  createdAt        DateTime               @default(now())
  // Report resolution (social-first AM1). Mirrors LookPostReport: unresolved
  // reports surface the comment in the moderation queue; dismiss/act sets these.
  resolvedAt       DateTime?
  resolvedByUserId String?

  lookComment LookComment @relation(fields: [lookCommentId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lookCommentId, userId])
  @@index([lookCommentId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([reason, createdAt])
  @@index([resolvedAt, createdAt])
}

model ViralServiceRequestReport {
  id                    String                 @id @default(cuid())
  viralServiceRequestId String
  userId                String
  reason                ModerationReportReason @default(OTHER)
  createdAt             DateTime               @default(now())

  viralServiceRequest ViralServiceRequest @relation(fields: [viralServiceRequestId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([viralServiceRequestId, userId])
  @@index([viralServiceRequestId, createdAt])
  @@index([userId, createdAt])
  @@index([reason, createdAt])
}

model LooksSocialJob {
  id           String               @id @default(cuid())
  type         LooksSocialJobType
  dedupeKey    String               @unique
  payload      Json
  status       LooksSocialJobStatus @default(PENDING)
  runAt        DateTime             @default(now())
  claimedAt    DateTime?
  processedAt  DateTime?
  failedAt     DateTime?
  attemptCount Int                  @default(0)
  maxAttempts  Int                  @default(5)
  lastError    String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, runAt, createdAt, id])
  @@index([type, status, runAt])
}

model ViralRequestApprovalFanOut {
  id String @id @default(cuid())

  viralServiceRequestId String
  professionalId        String

  status ViralRequestApprovalFanOutStatus @default(PLANNED)

  matchedAt DateTime  @default(now())
  queuedAt  DateTime?
  sentAt    DateTime?
  skippedAt DateTime?
  failedAt  DateTime?

  skipReason String?
  lastError  String?

  notificationId         String?
  notificationDispatchId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  viralServiceRequest  ViralServiceRequest   @relation(fields: [viralServiceRequestId], references: [id], onDelete: Cascade)
  professional         ProfessionalProfile   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  notification         Notification?         @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  notificationDispatch NotificationDispatch? @relation(fields: [notificationDispatchId], references: [id], onDelete: SetNull)

  @@unique([viralServiceRequestId, professionalId])
  @@index([viralServiceRequestId, status, createdAt])
  @@index([professionalId, status, createdAt])
  @@index([notificationId])
  @@index([notificationDispatchId])
}

model ProFollow {
  id             String   @id @default(cuid())
  clientId       String
  professionalId String
  createdAt      DateTime @default(now())

  client       ClientProfile       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([clientId, professionalId])
  @@index([professionalId, createdAt])
  @@index([clientId, createdAt])
}

// Client→client follow graph (engagement loop). Distinct from ProFollow
// (client→pro): this is one public-creator client following another. Powers the
// "FOLLOWERS" count and the activity "started following you" event.
model ClientFollow {
  id               String   @id @default(cuid())
  followerClientId String
  followedClientId String
  createdAt        DateTime @default(now())

  follower ClientProfile @relation("ClientFollowing", fields: [followerClientId], references: [id], onDelete: Cascade)
  followed ClientProfile @relation("ClientFollowers", fields: [followedClientId], references: [id], onDelete: Cascade)

  @@unique([followerClientId, followedClientId])
  @@index([followedClientId, createdAt])
  @@index([followerClientId, createdAt])
}

model Board {
  id             String          @id @default(cuid())
  clientId       String
  name           String
  // URL-safe handle for the public (SHARED) board page /u/[handle]/boards/[slug].
  // Derived from `name` on write; unique per client (social-first D3).
  slug           String
  visibility     BoardVisibility @default(PRIVATE)
  // Personalization context, captured once at board creation and freely
  // editable after (personalization spec §7–8). `type` says what the board is
  // for; `eventDate` is the calendar date it counts down to (bridal/prom — a
  // Postgres DATE, so no time-of-day/timezone semantics); `answers` holds the
  // skippable creation-question chips, validated against the question sets in
  // lib/boards/context.ts. type + eventDate feed the personalized-feed occasion boost;
  // answers are stored for the board-feed scoring pass (§4.4) and the
  // self-profile write-through (§6.6). Owner-only — never exposed on the
  // public board page.
  type           BoardType       @default(GENERAL)
  eventDate      DateTime?       @db.Date
  answers        Json?
  // Admin moderation flag for a SHARED board: when set, the public board page +
  // share surfaces 404 (owner keeps their private copy). Plain TEXT admin id —
  // no FK/back-relation, mirroring LookPost.featuredByUserId (social-first D3).
  hiddenAt       DateTime?
  hiddenByUserId String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  client ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items  BoardItem[]

  // Per-board local visual taste vector (personalization spec §6.0/§6.1) —
  // decayed average of the embeddings of this board's saved looks.
  tasteVector BoardTasteVector?

  @@unique([clientId, name])
  @@unique([clientId, slug])
  @@index([clientId, createdAt])
}

model BoardItem {
  id         String   @id @default(cuid())
  boardId    String
  lookPostId String
  createdAt  DateTime @default(now())

  board    Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  lookPost LookPost @relation(fields: [lookPostId], references: [id], onDelete: Cascade)

  @@unique([boardId, lookPostId])
  @@index([lookPostId, createdAt])
  @@index([boardId, createdAt])
}

// ==========================================
// PERSONALIZATION — VISUAL EMBEDDINGS (§6.0)
// ==========================================
//
// pgvector-backed tables for the visual-taste layer of the personalization
// spec. All `embedding` columns are Unsupported("vector(1024)") — Prisma's
// typed client can neither read nor write them (same constraint as
// ProfessionalSearchIndex.geom); every embedding read/write goes through raw
// SQL in lib/personalization/lookEmbeddingStore.ts / tasteVectors.ts. The
// vector dimension is pinned by LOOK_EMBEDDING_DIMENSIONS in
// lib/personalization/lookEmbedding.ts — the two must move together.
// `updatedAt`/`computedAt` carry DB defaults instead of @updatedAt because the
// raw-SQL writers maintain them explicitly.

// One embedding per look — the §6.0 "embed at upload" corpus. `model` records
// which provider model produced the vector and `mediaAssetId` which asset was
// embedded, so a model upgrade or primary-image swap makes the row detectably
// stale (the embed job + backfill re-embed on mismatch).
model LookPostEmbedding {
  lookPostId   String                      @id
  embedding    Unsupported("vector(1024)")
  model        String
  mediaAssetId String
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @default(now())

  lookPost LookPost @relation(fields: [lookPostId], references: [id], onDelete: Cascade)

  @@index([model])
}

// Per-look, per-source, per-day impression aggregate (spec §5.6 anti-gaming
// groundwork). LookPost.viewCount stays the lifetime rate denominator (§4.1);
// this table breaks the same sampled impressions down by source and daily
// window so a velocity-anomaly check (step 14) can spot engagement that spikes
// far outside its matching impression baseline. Written only by the
// APPLY_LOOK_VIEWS job — one upsert per (look, source) it touches, incrementing
// `count`. `windowDate` is stamped server-side from job-run time (UTC day):
// impressions are sampled/best-effort so the client is never trusted with the
// window. This data is time-sensitive and cannot be backfilled — hence captured
// now, ahead of its step-14 reader.
model LookPostImpressionStat {
  lookPostId String
  source     LookImpressionSource
  windowDate DateTime             @db.Date
  count      Int                  @default(0)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  lookPost LookPost @relation(fields: [lookPostId], references: [id], onDelete: Cascade)

  @@id([lookPostId, source, windowDate])
  @@index([windowDate])
  @@index([lookPostId, windowDate])
}

// Per-viewer, per-look feed-exposure counter (spec §4.6 impression capping).
// Unlike the session `seen` list (client-supplied, resets every session) this
// PERSISTS a viewer's feed exposures across sessions, so a look that a viewer
// has scrolled past enough times stops re-appearing in their personalized feed
// (it can still be opened directly — the cap only governs the feed).
//
// Written by the APPLY_LOOK_VIEWS job: only FEED-source impressions increment
// the count (a DETAIL open is explicit nav, not an unwanted repeat), and only
// when the flushing viewer is signed in (guests get no row — the aggregate
// LookPostImpressionStat path is unaffected). Read by loadPersonalizedAffinity
// (lib/looks/viewerImpressionCap.ts), which lists the looks at/above the cap for
// the feed's hard exclusion.
model LookViewerImpressionStat {
  userId     String
  lookPostId String
  // How many FEED exposures this viewer has had of this look (≈ once per
  // browsing session — the client dedupes per session).
  count      Int      @default(0)
  // The most recent exposure — drives which capped ids win the bounded read.
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lookPost LookPost @relation(fields: [lookPostId], references: [id], onDelete: Cascade)

  @@id([userId, lookPostId])
  // The reader filters by (userId, count >= cap) and orders by recency; this
  // composite covers the capped-id lookup.
  @@index([userId, count])
  @@index([lookPostId])
}

// Global taste vector per client (§6.0/§6.1 global_taste_embedding): the
// decayed, signal-weighted average of the embeddings of looks the client
// liked/saved. Recomputed from scratch by the taste-vectors job — never
// incrementally mutated — so decay stays exact.
model ClientTasteVector {
  clientProfileId String                      @id
  embedding       Unsupported("vector(1024)")
  model           String
  // How many embedded like/save signals contributed — a confidence signal for
  // ranking consumers (a 2-signal vector should steer less than a 50-signal one).
  signalCount     Int
  computedAt      DateTime                    @default(now())
  createdAt       DateTime                    @default(now())

  client ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
}

