/// The ONE global namespace for public `@handle`s.
///
/// `ProfessionalProfile.handleNormalized` and `ClientProfile.handleNormalized`
/// each carry their own `@unique`. That makes a handle unique *within* a table
/// and says nothing across them, so the same handle could be held by a pro AND
/// a client at once — which is not cosmetic: the looks feed renders a
/// client-authored post and a pro-authored post as the same `@handle`, side by
/// side, with no type marker (`LookOverlays.tsx`). A client could claim a
/// well-known pro's handle and post under their identity.
///
/// Postgres cannot express a unique index spanning two tables, so this registry
/// IS the constraint: `handleNormalized` is the PRIMARY KEY, and the database
/// refuses the second claim no matter which table it comes from. The per-table
/// `handleNormalized` columns stay as the display/lookup source of truth; this
/// table is purely the lock.
///
/// Exactly one owner column is set, enforced by a CHECK constraint — a row
/// owned by nobody would squat a handle with no way to reach or release it.
/// Both FKs cascade: a deleted profile must never leave its handle locked.
///
/// Write ONLY through lib/handles/registry.ts.
model HandleRegistration {
  handleNormalized String @id @db.VarChar(24)

  professionalId  String? @unique
  clientProfileId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professional  ProfessionalProfile? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  clientProfile ClientProfile?       @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
}

/// A user's own request to delete their account (App Store guideline 5.1.1(v)).
///
/// The request is a ROW, not a flag on User, for two reasons: it must survive
/// the deletion it caused — otherwise nothing evidences that the request was
/// honoured — and a cancelled request is history worth keeping when the same
/// account asks again.
///
/// Exactly one PENDING request per user is enforced by a PARTIAL UNIQUE INDEX
/// created in the migration (Prisma cannot express `WHERE status = 'PENDING'`),
/// so a double-tap cannot open two windows even under a race.
model AccountDeletionRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserAccountDeletionRequests", fields: [userId], references: [id], onDelete: Cascade)

  status AccountDeletionRequestStatus @default(PENDING)

  requestedAt  DateTime @default(now())
  /// Earliest instant the sweep may execute this request: requestedAt plus the
  /// grace window. The window is the user's chance to change their mind.
  scheduledFor DateTime

  cancelledAt DateTime?
  completedAt DateTime?

  /// Optional free text the user gave for leaving. Never rendered to a pro.
  reason String? @db.VarChar(500)

  /// Summary of what the executed deletion actually did, for the audit trail.
  resultJson Json?

  failureCount       Int       @default(0)
  lastFailureAt      DateTime?
  lastFailureMessage String?   @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledFor])
  @@index([userId, status])
}

enum AccountDeletionRequestStatus {
  /// Inside the grace window; the user can still cancel.
  PENDING
  /// The user changed their mind before the window closed.
  CANCELLED
  /// Executed: deleteUserData ran to completion.
  COMPLETED
  /// Execution errored. Left for an operator rather than retried forever.
  FAILED
}

// ── AI Consult (ai-consult.md, Phase 0 — C1: schema + route skeleton) ───────
//
// ⚠️ NAMING COLLISION, do not confuse: "Consultation" already means the
// pro-initiated, MID-APPOINTMENT price-approval flow (`ConsultationApproval`,
// deprecated `BookingConsultation`, guard-protected by
// tools/check-consultation-canonical.mjs). `ConsultSession` is a completely
// different concept — a PRE-VISIT client intake that produces an AI analysis
// and a pro-facing brief. Never read or write the legacy consultation models
// from this feature, and never let this model's relations/routes collide with
// theirs.

/// Consent-first lifecycle for one booking-attached hair-color consult. The
/// database permits only the transitions in consult_lifecycle_guard and blocks
/// every sensitive state until BOTH legal prerequisites are active.
enum ConsultSessionStatus {
  CONSENT_REQUIRED
  INTAKE_READY
  INTAKE_IN_PROGRESS
  MEDIA_READY
  ANALYSIS_PENDING
  ANALYZING
  COMPLETED
  CONSENT_REVOKED
  CANCELLED
}

enum ConsultRevisionKind {
  INTAKE
  ANALYSIS
  BRIEF
}

enum ConsultAgreementKind {
  SENSITIVE_DATA_CONSENT
  ADULT_18_PLUS_ATTESTATION
}

enum ConsultActorType {
  CLIENT
  PROFESSIONAL
  SYSTEM
}

enum ConsultAuditAction {
  SESSION_CREATED
  AGREEMENT_ACCEPTED
  AGREEMENT_REVOKED
  LIFECYCLE_TRANSITIONED
  REVISION_CREATED
}

/// A client's pre-visit AI consult (ai-consult.md). Phase 0 is booking-attached
/// and founder-gated (lib/consult/access.ts, the technical-record allowlist
/// precedent): a client runs a consult tied to an upcoming booking, and the
/// resulting brief surfaces to the pro before the appointment.
///
/// Phase 0 creation derives the category, professional and booking anchors from
/// the owned booking. All are required, and `bookingId` is unique: one consult
/// per booking. Standalone consults are outside the founder pilot.
///
/// Durable consult content is append-only in ConsultRevision. Raw consult
/// photos are explicitly NOT durable and have no table in this foundation;
/// a later capture step must use expiring private objects and verified purge.
/// Client account deletion removes the session and cascades every revision,
/// legal acceptance, and audit event.
model ConsultSession {
  id String @id @default(cuid())

  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // The founder pilot admits only the hair-color category (eligibility.ts).
  // Keep the real category FK so the booking remains the scope authority.
  serviceCategoryId String
  serviceCategory   ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Restrict)

  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Restrict)

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  // An empty booking-attached shell starts here. No sensitive intake or media
  // may be collected until active, version-pinned records exist for BOTH the
  // sensitive-data consent and the 18+ attestation.
  status ConsultSessionStatus @default(CONSENT_REQUIRED)

  // Atomically incremented by lib/consult/writeBoundary.ts before an immutable
  // ConsultRevision is inserted. It is coordination metadata, not content.
  revisionSequence Int @default(0)

  revisions            ConsultRevision[]
  agreementAcceptances ConsultAgreementAcceptance[]
  auditEvents          ConsultAuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, createdAt])
  @@index([professionalId, status])
  @@index([serviceCategoryId])
}

/// One immutable payload revision. The session row never contains mutable
/// intake/analysis/brief JSON: corrections and reruns append a new numbered
/// row, preserving exactly what existed before. A database trigger rejects
/// UPDATEs and rejects inserts unless both legal prerequisites are active.
model ConsultRevision {
  id String @id @default(cuid())

  consultSessionId String
  consultSession   ConsultSession @relation(fields: [consultSessionId], references: [id], onDelete: Cascade)

  revision Int
  kind     ConsultRevisionKind
  payload  Json

  schemaVersion Int
  model         String?
  promptVersion String?

  // Client intake retries pin a caller-owned key to the canonical request
  // hash. Both are null for non-client/internal revision kinds.
  idempotencyKey String? @db.VarChar(128)
  requestHash    String? @db.Char(64)

  createdAt DateTime @default(now())

  auditEvents ConsultAuditEvent[]

  @@unique([consultSessionId, revision])
  @@unique([consultSessionId, idempotencyKey])
  @@index([consultSessionId, createdAt])
}

/// Immutable, published wording for one prerequisite. Consent and the 18+
/// statement are independently versioned; an acceptance always points to the
/// exact words shown. Publishing changed words means inserting version n+1.
model ConsultAgreementVersion {
  id String @id @default(cuid())

  kind    ConsultAgreementKind
  version Int
  title   String
  body    String

  publishedAt DateTime @default(now())

  acceptances ConsultAgreementAcceptance[]

  @@unique([kind, version])
  @@index([kind, publishedAt])
}

/// A client's version-pinned acceptance. Revocation never deletes or rewrites
/// the evidence: it stamps revokedAt/revocationReason once, appends an audit
/// event, and moves the session to CONSENT_REVOKED. Re-consent is a new row.
model ConsultAgreementAcceptance {
  id String @id @default(cuid())

  consultSessionId String
  consultSession   ConsultSession @relation(fields: [consultSessionId], references: [id], onDelete: Cascade)

  agreementVersionId String
  agreementVersion   ConsultAgreementVersion @relation(fields: [agreementVersionId], references: [id], onDelete: Restrict)

  // Denormalized for an enforceable partial unique index: at most one active
  // acceptance of each prerequisite per session. A database trigger proves it
  // matches agreementVersion.kind.
  kind ConsultAgreementKind

  acceptedAt       DateTime          @default(now())
  acceptedByType   ConsultActorType
  acceptedById     String
  revokedAt        DateTime?
  revokedByType    ConsultActorType?
  revokedById      String?
  revocationReason String?           @db.VarChar(500)

  auditEvents ConsultAuditEvent[]

  @@index([consultSessionId, kind, revokedAt])
  @@index([agreementVersionId])
}

/// Append-only minimum audit trail for the transitions that control access to
/// sensitive consult data. Deliberately contains identifiers and lifecycle
/// facts only; intake/media/analysis content never belongs in an audit row.
model ConsultAuditEvent {
  id String @id @default(cuid())

  consultSessionId String
  consultSession   ConsultSession @relation(fields: [consultSessionId], references: [id], onDelete: Cascade)

  action    ConsultAuditAction
  actorType ConsultActorType
  actorId   String?

  fromStatus ConsultSessionStatus?
  toStatus   ConsultSessionStatus?

  agreementAcceptanceId String?
  agreementAcceptance   ConsultAgreementAcceptance? @relation(fields: [agreementAcceptanceId], references: [id], onDelete: Cascade)

  revisionId String?
  revision   ConsultRevision? @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([consultSessionId, createdAt])
  @@index([agreementAcceptanceId])
  @@index([revisionId])
}
