  locations       ProfessionalLocation[]
  offerings       ProfessionalServiceOffering[]
  bookings        Booking[]
  calendarBlocks  CalendarBlock[]
  consultSessions ConsultSession[]

  calendarFeedSubscription CalendarFeedSubscription?

  notifications              Notification[]
  notificationDispatches     NotificationDispatch[]               @relation("ProfessionalNotificationDispatches")
  notificationPreferences    ProfessionalNotificationPreference[]
  consultationApprovalProofs ConsultationApprovalProof[]
  clientActionTokens         ClientActionToken[]
  // Licensing / verification (unchanged)
