enum NotificationRecipientKind {
  PRO
  CLIENT
  ADMIN
}

enum NotificationEventKey {
  BOOKING_REQUEST_CREATED
  BOOKING_CONFIRMED
  BOOKING_STARTED
  BOOKING_RESCHEDULED
  BOOKING_CANCELLED_BY_CLIENT
  BOOKING_CANCELLED_BY_PRO
  BOOKING_CANCELLED_BY_ADMIN
  CLIENT_CLAIM_INVITE
  CONSULTATION_PROPOSAL_SENT
  CONSULTATION_APPROVED
  CONSULTATION_REJECTED
  REVIEW_RECEIVED
  // Post-visit "leave a review" nudge to the client, scheduled a few hours
  // after the booking completes (lib/notifications/reviewRequests.ts).
  REVIEW_REQUESTED
  APPOINTMENT_REMINDER
  AFTERCARE_READY
  LAST_MINUTE_OPENING_AVAILABLE
  // A pro proposed a specific appointment time to a waitlisted client; the
  // client must Confirm before it books (see WaitlistOffer).
  WAITLIST_TIME_OFFERED
  // W2: a client JOINED a pro's waitlist — the other direction. Before this
  // there was no notification at all: the waitlist POST wrote a seed message
  // with raw Prisma, so the only signal a pro ever got was an unread inbox dot,
  // and only while they happened to be in the app. A new waitlister is a lead,
  // so this one carries email as well as in-app + push.
  WAITLIST_JOINED
  // A pro's offered time lapsed unanswered — the sweep flipped the offer to
  // WaitlistOfferStatus.EXPIRED and returned the entry NOTIFIED → ACTIVE. Told
  // to the PRO, and deliberately QUIET (in-app only): nobody did anything, so
  // waking the pro for a non-event would be the wrong trade. Its whole job is to
  // explain why the client reappeared on the waitlist.
  WAITLIST_OFFER_EXPIRED
  // A waitlisted client LEFT while the pro had a live offer out to them, so the
  // slot that offer was reserving just went back on the market. Pro-facing and
  // in-app + push, because there is now a concrete hole in the calendar the pro
  // can re-offer. Emitted ONLY when an offer was actually pending — a client
  // leaving with nothing outstanding is silent by decision.
  WAITLIST_CLIENT_LEFT
  VIRAL_REQUEST_APPROVED
  PAYMENT_COLLECTED
  PAYMENT_ACTION_REQUIRED
  // An off-platform payment (cash / Venmo / Zelle / Apple Cash / PayPal) is
  // awaiting the pro's confirmation of receipt. Pro-facing: confirming it both
  // closes out the current booking's payment AND approves any aftercare-sourced
  // next appointment coupled to it (see confirmProBookingPaymentReceived).
  PAYMENT_CONFIRMATION_REQUIRED
  // Refund receipt (final-bill or deposit refund) — emitted from the refund
  // reconcile paths.
  PAYMENT_REFUNDED
  // A no-show / late-cancel fee was charged to the client's saved card (Phase 2
  // revenue protection). Client-facing receipt; inert unless the flag is on.
  NO_SHOW_FEE_CHARGED
  // A no-show kept the client's captured discovery deposit (M15 POLICY): the kept
  // deposit IS the penalty, so no separate no-show fee is charged. This is the
  // client's disclosure of that outcome. Client-facing; inert unless the flag is on.
  NO_SHOW_DEPOSIT_KEPT
  // A new-client discovery deposit is still unpaid and the booking's hold is
  // approaching its auto-release deadline (M5). Client-facing nudge to complete
  // the deposit checkout before the slot is freed. Respects quiet hours.
  DEPOSIT_REMINDER
  // K10-B: the secure pay-link delivery for a pro-created booking's deposit —
  // EMAIL/SMS carrying the /client/deposit/<token> magic link, because the
  // client is often unclaimed and cannot use the login-gated deposit surface.
  DEPOSIT_PAYMENT_LINK
  // K15: the secure consent-signature link — EMAIL/SMS carrying
  // /client/consent/<token> so a client (often unclaimed) can read and sign the
  // waiver their pro's service requires. The link pins ONE ConsentFormVersion;
  // the ask is per booking, because that is when the requirement becomes real.
  CONSENT_SIGNATURE_REQUEST
  // W5 follow-up: a pro asked to read a client's chart (ClientChartShare →
  // REQUESTED). Client-facing, and the ONLY way the ask reaches the person who
  // has to answer it — the request row alone is silent, so a client would have
  // to happen to open /client/settings to ever learn they were asked.
  CHART_ACCESS_REQUESTED
  // W5 follow-up: the client said yes (ClientChartShare → GRANTED). Pro-facing.
  // Emitted ONLY for a grant — a decline is deliberately not notified, so the
  // answer a client is most likely to feel awkward about is not also an event
  // that lands in the asker's inbox.
  CHART_ACCESS_GRANTED
  // K12: the client answered an appointment-confirmation ask with "can't make
  // it" (Booking.clientConfirmationDeclinedAt). Pro-facing. The slot stays
  // occupied — D5: an unconfirmed appointment NEVER auto-cancels; cancelling
  // stays the pro's human decision, and this notification is how they learn.
  APPOINTMENT_CONFIRMATION_DECLINED
  LOOK_FOLLOWER_NEW
  // Client→client follow ("started following you") — powers the activity feed.
  CLIENT_FOLLOW
  // Someone commented on your look — routed to the look's author (the pro, or
  // the client author for client-shared looks).
  LOOK_COMMENTED
  // Someone replied to your comment on a look — routed to the parent comment's
  // author (pro or client).
  LOOK_COMMENT_REPLIED
  // Batched "your look got liked" — one refreshed inbox row per look per day
  // (windowed dedupeKey), count carried in data. Routed to the look's author.
  LOOK_LIKED
  // Batched "your look got saved to a board" — same windowed-dedupe shape as
  // LOOK_LIKED. Routed to the look's author.
  LOOK_SAVED
  // A pro you follow published a new look — fanned out to ProFollow followers
  // via the FAN_OUT_NEW_LOOK_NOTIFICATIONS job.
  LOOK_NEW_FROM_FOLLOWED_PRO
  // "Your look hit N likes / N saves" — a one-time supply-side growth nudge to
  // the look's author (pro, or client author) each time a like/save threshold is
  // crossed. Fires once per (look, metric, threshold) via a permanent dedupeKey.
  LOOK_MILESTONE_REACHED
  REFERRAL_TAP_RECEIVED
  REFERRAL_CONFIRMED
  REFERRAL_CONVERTED

  // §6.8 saved-not-booked activation, gated by the §8.1 re-engagement budget: a
  // pro whose look a client saved (but never booked) now has a near-term calendar
  // opening. A gentle client-facing nudge to book that saved look — one per
  // (client, pro) per cooldown window, pooled under the re-engagement budget with
  // event countdowns and rebook prompts (lib/notifications/reEngagementBudget.ts,
  // emitter lib/notifications/savedLookActivation.ts).
  SAVED_LOOK_AVAILABILITY_OPENED

  // §8 event-date countdown, the HIGHEST-priority re-engagement trigger under the
  // §8.1 budget: a client's dated board (Board.eventDate — a bridal/prom board) is
  // approaching a milestone (30/14/7/3 days out), so gently nudge them to book
  // their looks while there's still time. One per (board, milestone), pooled under
  // the re-engagement budget (lib/notifications/reEngagementBudget.ts, emitter
  // lib/notifications/eventCountdownNotifications.ts). Never day-of or past.
  EVENT_DATE_COUNTDOWN

  // §6.7 cadence-timed rebook prompt, gated by the §8.1 re-engagement budget: a
  // client is now due for a refresh with a pro they've visited before (past that
  // pair's learned cadence — lib/clients/relationshipIntelligence.ts — or the
  // offering's static rebookIntervalDays) and the pro has a near-term opening. A
  // gentle "time for a refresh?" nudge, one per (client, pro) per cooldown window,
  // pooled under the re-engagement budget (emitter
  // lib/notifications/rebookCadenceNotifications.ts). Excludes pairs with an
  // upcoming booking; never fires for a churned (far-overdue) relationship.
  REBOOK_CADENCE_DUE

  // §6.8 hesitation blocker response, gated by the §8.1 re-engagement budget: a
  // client saved a HIGH-/MEDIUM-commitment look (permanent makeup, color,
  // extensions, lashes, skin — lib/looks/badges/commitmentTiers.ts) but never
  // booked that pro. A big decision deserves information, not urgency, so this
  // sends a gentle "have questions? book a consult when you're ready" nudge — one
  // per (client, pro) per cooldown window, pooled under the re-engagement budget
  // (emitter lib/notifications/hesitationConsultNudge.ts). Never availability- or
  // deadline-driven; the lowest-priority live re-engagement trigger.
  SAVED_LOOK_CONSULT_NUDGE

  // §6.8 price blocker response, gated by the §8.1 re-engagement budget: a client
  // saved a look priced well ABOVE their LEARNED price band (lib/looks/personalizedFeed.ts
  // learnPriceBand, from completed-booking service prices — spec §4.5) but never
  // booked that pro. Rather than keep surfacing out-of-budget work, gently point
  // them at a SIMILAR look (same service category) from a different pro whose price
  // sits IN their band — "surface in-band similar looks", the §6.8 table's price
  // row. One per (client, over-budget pro) per cooldown window, pooled under the
  // re-engagement budget (emitter lib/notifications/savedLookPriceAlternative.ts).
  // The copy never names price — the band is selection logic, not a judgment.
  SAVED_LOOK_PRICE_ALTERNATIVE

  // A new message landed in a thread the recipient participates in. Routed to
  // the OTHER participant (client or pro). Debounced per thread per recipient so
  // a rapid burst refreshes one inbox row / fires one push rather than spamming.
  MESSAGE_RECEIVED

  // A not-yet-premium pro's reserved vanity handle is about to be released for
  // inactivity. Heads-up before the expiry cron reclaims it.
  PRO_HANDLE_RESERVATION_EXPIRING

  // License-expiry lifecycle (Tori approved 2026-08-06). 30 days before
  // ProfessionalProfile.licenseExpiry, a heads-up to renew before the
  // verified badge pauses (lib/licensing/licenseExpiryNotifications.ts).
  PRO_LICENSE_EXPIRING_SOON
  // Same sweep: fires once the license has actually expired — the verified
  // badge is now paused (derived; see lib/licensing/currentlyLicensed.ts),
  // and this tells the pro how to restore it (upload a renewed license).
  PRO_LICENSE_EXPIRED

  // Admin operational alerts — fanned out to all users with role ADMIN.
  // A pro submitted a verification document or edited their license (re-review).
  ADMIN_VERIFICATION_REVIEW_NEEDED
  // A new support ticket was created.
  ADMIN_SUPPORT_TICKET_CREATED
  // A new viral-service request is pending an admin decision.
  ADMIN_VIRAL_REQUEST_PENDING
