model BookingOverridePermission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actorUserId String
  actorUser   User   @relation("BookingOverridePermissionActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  grantedByUserId String?
  grantedByUser   User?   @relation("BookingOverridePermissionGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  rule  BookingOverrideRule
  scope BookingOverridePermissionScope @default(SELF_ONLY)

  /**
   * Required for SELF_ONLY and PROFESSIONAL_TEAM.
   * Nullable only for ANY_PROFESSIONAL.
   */
  professionalId String?
  professional   ProfessionalProfile? @relation("BookingOverridePermissionProfessional", fields: [professionalId], references: [id], onDelete: Cascade)

  /**
   * Operational controls
   */
  isActive        Boolean   @default(true)
  startsAt        DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  revokedByUserId String?
  revokedByUser   User?     @relation("BookingOverridePermissionRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  /**
   * Why this permission exists.
   * Keep boring and explicit.
   */
  reason String?

  /**
   * Optional metadata for ticket id / change request / rollout note.
   */
  metadata Json?

  /**
   * Prevent duplicate active-looking grants for same actor/rule/scope/target.
   * Prisma can't do partial unique indexes, so we use a plain compound unique key.
   * Your app logic should revoke/disable old rows instead of inserting duplicates.
   */
  @@unique([actorUserId, rule, scope, professionalId])
  @@index([actorUserId, isActive, rule])
  @@index([professionalId, isActive, rule])
  @@index([rule, isActive, startsAt, expiresAt])
  @@index([grantedByUserId, createdAt])
  @@index([revokedByUserId, createdAt])
}

model BookingHold {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  offeringId     String
  professionalId String
  clientId       String?

  scheduledFor DateTime
  expiresAt    DateTime

  // Mirrors Booking.allowsOverlap: a hold flagged for an authorized overlap is
  // exempt from BookingHold_no_active_professional_overlap. Defaults false;
  // clients can't authorize overlap and pros create bookings directly (no hold),
  // so this is effectively always false today — kept for symmetry/future use.
  allowsOverlap Boolean @default(false)

  locationType ServiceLocationType

  locationId String
  location   ProfessionalLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  locationTimeZone        String? @db.VarChar(64)
  locationAddressSnapshot Json?
  locationLatSnapshot     Float?
  locationLngSnapshot     Float?

  encryptedLocationAddressSnapshotJson Json?
  locationAddressSnapshotKeyVersion    String? @db.VarChar(32)
  locationLatApprox                    Float?
  locationLngApprox                    Float?

  client       ClientProfile?              @relation(fields: [clientId], references: [id])
  offering     ProfessionalServiceOffering @relation(fields: [offeringId], references: [id])
  professional ProfessionalProfile         @relation("ProHolds", fields: [professionalId], references: [id])

  // Client destination for mobile bookings
  clientAddressId String?
  clientAddress   ClientAddress? @relation(fields: [clientAddressId], references: [id], onDelete: SetNull)

  clientAddressSnapshot    Json?
  clientAddressLatSnapshot Float?
  clientAddressLngSnapshot Float?

  encryptedClientAddressSnapshotJson Json?
  clientAddressSnapshotKeyVersion    String?   @db.VarChar(32)
  clientAddressLatApprox             Float?
  clientAddressLngApprox             Float?
  addressSnapshotsEncryptedAt        DateTime?

  durationMinutesSnapshot Int?
  bufferMinutesSnapshot   Int?
  endsAtSnapshot          DateTime?

  // Set when this hold is a pro's waitlist offer reserving the slot it promised
  // (F14: "if a pro chooses a time it should reserve the spot"). Null for an
  // ordinary client-picked hold, which is the discriminator two paths rely on:
  // deleteActiveHoldsForClient must not drop an offer's reservation when the
  // client starts an unrelated booking, and releaseHold must not let the client
  // un-reserve it without declining. Cascade because a reservation cannot
  // outlive the offer it belongs to.
  waitlistOfferId String?        @unique
  waitlistOffer   WaitlistOffer? @relation(fields: [waitlistOfferId], references: [id], onDelete: Cascade)

  // Set when this hold was placed to MOVE an existing booking (B3). Two jobs:
  // the reservation is sized from that booking's committed
  // `totalDurationMinutes` rather than the offering's current base, and the
  // add-on re-size path (PATCH /holds/[id]) refuses the hold outright — that
  // endpoint recomputes width from the OFFERING, which would narrow a
  // reschedule hold straight back to the gap this column exists to close.
  // Same discriminator role `waitlistOfferId` plays for a pro's offer.
  rescheduleBookingId String?
  rescheduleBooking   Booking? @relation("BookingHoldRescheduleTarget", fields: [rescheduleBookingId], references: [id], onDelete: Cascade)

  // Server-validated at hold creation (looks-feed lookPost ownership / discovery
  // attribution / NFC / relationship). Copied to Booking.discoveryProvenance at
  // finalize so the platform-fee decision never trusts client input.
  discoveryProvenance BookingDiscoveryProvenance @default(UNKNOWN)

  @@unique([professionalId, scheduledFor])
  @@index([expiresAt])
  @@index([locationId, scheduledFor])
  @@index([professionalId, expiresAt])
  @@index([professionalId, scheduledFor, expiresAt])
  @@index([offeringId, scheduledFor])
  @@index([rescheduleBookingId])
  @@index([clientId, expiresAt])
  @@index([clientAddressId])
  @@index([locationAddressSnapshotKeyVersion])
  @@index([clientAddressSnapshotKeyVersion])
  @@index([addressSnapshotsEncryptedAt])
}

model ProClientInvite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Nullable: a claim invite can be pro-less (cold self-serve, no pro in context)
  // and/or booking-less (a directory-created / migration-imported client with no
  // appointment). Postgres treats NULLs as distinct, so `bookingId @unique` still
