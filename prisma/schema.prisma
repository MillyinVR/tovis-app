  // This matters because calendar months are timezone-sensitive.
  timeZone String @db.VarChar(64)

  periodStartUtc DateTime
  periodEndUtc   DateTime

  // Money is stored as cents so dashboard reads avoid Decimal math.
  // Revenue total intentionally excludes tips.
  serviceRevenueCents Int @default(0)
  productRevenueCents Int @default(0)
  revenueTotalCents   Int @default(0)
  tipCents            Int @default(0)

  completedBookingCount Int @default(0)

  uniqueClientCount         Int @default(0)
  newClientCount            Int @default(0)
  repeatClientCount         Int @default(0)
  futureRebookedClientCount Int @default(0)
  noFutureRebookClientCount Int @default(0)

  requestedNewBookingCount    Int @default(0)
  requestedRepeatBookingCount Int @default(0)
  discoveryNewBookingCount    Int @default(0)
  discoveryRepeatBookingCount Int @default(0)
  aftercareBookingCount       Int @default(0)

  reviewCount   Int      @default(0)
  ratingSum     Int      @default(0)
  averageRating Decimal? @db.Decimal(3, 2)

  computedAt DateTime @default(now())
  createdAt  DateTime @default(now())
