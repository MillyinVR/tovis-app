model Booking {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId       String
  professionalId String
  serviceId      String
  offeringId     String?

  // Tenant attribution snapshots, written at booking creation (contract
  // phase: required). proTenantId = revenue attribution (the Pro's home
  // tenant); clientHomeTenantId = acquisition attribution (the client's
  // signup tenant). See docs/architecture/tenant-model.md.
  proTenantId        String
  proTenant          Tenant @relation("TenantProBookings", fields: [proTenantId], references: [id], onDelete: Restrict)
  clientHomeTenantId String
  clientHomeTenant   Tenant @relation("TenantClientHomeBookings", fields: [clientHomeTenantId], references: [id], onDelete: Restrict)

  proClientInvite ProClientInvite?

  lastMinuteOpeningId String?            @unique
  lastMinuteOpening   LastMinuteOpening? @relation("BookingLastMinuteOpening", fields: [lastMinuteOpeningId], references: [id], onDelete: SetNull)

  // Remix attribution (engagement loop): the look that inspired this booking, if
  // the client booked "recreate this look". Powers "Your looks, remixed".
  // SetNull so a booking survives the source look being removed.
  sourceLookPostId String?
  sourceLookPost   LookPost? @relation("LookInspiredBookings", fields: [sourceLookPostId], references: [id], onDelete: SetNull)

  scheduledFor DateTime
  status       BookingStatus @default(PENDING)

  // Cancellation provenance, stamped by the boundary's terminal-cancel writers
  // alongside status=CANCELLED. A payment webhook that lands AFTER the cancel
  // must run the same refund policy the cancel-time helpers ran (who cancelled +
  // when decide eligibility — see lib/booking/cancelRefund.ts,
  // applyLateCaptureCancelRefund). Null on bookings cancelled before these
  // columns existed, and on system cancels with no acting role — the late-capture
  // path alerts instead of guessing policy for those.
  cancelledAt     DateTime?
  cancelledByRole Role?

  // When true, this booking is exempt from the overlap EXCLUDE constraint
  // (Booking_no_active_professional_overlap). Set only by the write boundary when
  // a PRO/ADMIN intentionally double-books, or an aftercare pre-selected slot
  // overlaps — derived from the overlap policy decision, never from client input.
  allowsOverlap Boolean @default(false)

  // Booking mode: SALON or MOBILE
  locationType ServiceLocationType

  // REQUIRED: lock booking to a specific ProfessionalLocation
  locationId String
  location   ProfessionalLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  // Snapshots that make bookings immutable + timezone safe
  locationTimeZone        String? @db.VarChar(64)
  locationAddressSnapshot Json?
  locationLatSnapshot     Float?
  locationLngSnapshot     Float?

  encryptedLocationAddressSnapshotJson Json?
  locationAddressSnapshotKeyVersion    String? @db.VarChar(32)
  locationLatApprox                    Float?
  locationLngApprox                    Float?

  // Client destination for mobile bookings
  clientAddressId String?
  clientAddress   ClientAddress? @relation(fields: [clientAddressId], references: [id], onDelete: SetNull)

  clientAddressSnapshot    Json?
  clientAddressLatSnapshot Float?
  clientAddressLngSnapshot Float?

  encryptedClientAddressSnapshotJson Json?
  clientAddressSnapshotKeyVersion    String?   @db.VarChar(32)
  clientAddressLatApprox             Float?
  clientAddressLngApprox             Float?
  addressSnapshotsEncryptedAt        DateTime?

  // Client-friendly display (optional)
  clientTimeZoneAtBooking String? @db.VarChar(64)

  // Pricing + duration
  subtotalSnapshot        Decimal  @db.Decimal(10, 2)
  totalAmount             Decimal? @db.Decimal(10, 2)
  depositAmount           Decimal? @db.Decimal(10, 2)
  tipAmount               Decimal? @db.Decimal(10, 2)
  taxAmount               Decimal? @db.Decimal(10, 2)
  discountAmount          Decimal? @db.Decimal(10, 2)
  serviceSubtotalSnapshot Decimal? @db.Decimal(10, 2)
  productSubtotalSnapshot Decimal? @db.Decimal(10, 2)

  checkoutStatus        BookingCheckoutStatus @default(NOT_READY)
  selectedPaymentMethod PaymentMethod?
  paymentCollectedAt    DateTime?
  paymentAuthorizedAt   DateTime?

  paymentProvider PaymentProvider @default(MANUAL)

  stripeCheckoutSessionId     String?                      @unique
  stripePaymentIntentId       String?                      @unique
  stripeConnectedAccountId    String?
  stripeCheckoutSessionStatus StripeCheckoutSessionStatus?
  stripePaymentStatus         StripePaymentStatus?
  stripeAmountSubtotal        Int?
  stripeAmountTotal           Int?
  stripeApplicationFeeAmount  Int?
  // Stripe's authoritative cumulative SUCCEEDED-refund total (minor units),
  // synced from charge.refunded webhooks. Includes refunds issued outside the
  // app (e.g. the Stripe Dashboard) that never create a BookingRefund row, so
  // the refund-reservation math can't double-refund what Stripe already gave back.
  stripeAmountRefunded        Int                          @default(0)
  stripeCurrency              String?                      @db.VarChar(3)
  stripePaidAt                DateTime?
  stripeLastEventId           String?

  totalDurationMinutes Int
  bufferMinutes        Int @default(0)

  source            BookingSource @default(DISCOVERY)
  rebookOfBookingId String?

  // How the client found this pro. Server-validated at hold creation and copied
  // here at finalize — NEVER trusted from client input, because LOOKS_FEED /
  // DISCOVERY_SEARCH gate the one-time platform fee. See lib/booking/discoveryFee.ts.
  discoveryProvenance BookingDiscoveryProvenance @default(UNKNOWN)

  // NR/NNR/RR/RNR salon-book mark, stamped once at create (same snapshot rule as
  // discoveryProvenance). The default only covers rows that predate the column —
  // history backfills to UNKNOWN rather than guessing; every write path stamps
  // explicitly via lib/booking/relationshipLabel.ts.
  clientRelationshipLabel ClientRelationshipLabel @default(UNKNOWN)

  // New-client deposit captured up front, as its OWN charge (distinct from the
  // final bill's stripe* fields). The deposit credits toward the final total.
  depositStatus                BookingDepositStatus @default(NONE)
  depositStripePaymentIntentId String?              @unique
  depositStripeChargeId        String?
  depositPaidAt                DateTime?
  depositCreditedAt            DateTime? // when the deposit was applied against the final total
  // Cumulative cents refunded against the deposit charge. depositStatus only
  // flips to REFUNDED once this reaches the full deposit-charge total; a partial
  // refund keeps depositStatus PAID + records the cents so a later full refund
  // isn't blocked and we can't over-refund. See lib/booking/refunds.ts.
  depositRefundedCents         Int                  @default(0)
  // Set when the deposit charge is under (or lost) a Stripe dispute; cleared if
  // the dispute is WON. The deposit rides its OWN PaymentIntent, so a deposit
  // dispute never touches stripePaymentStatus (that tracks the final-bill PI) —
  // this is the deposit's equivalent freeze. While set, refundDiscoveryDeposit
  // and the M3 retry sweep refuse to refund: Stripe has already pulled the
  // funds via the dispute, so issuing our own refund would double-return them.
  // See lib/booking/writeBoundary.ts (applyStripeDepositDisputeInTransaction).
  depositDisputedAt            DateTime?
  // K10-B: when an unpaid (PENDING) deposit's hold is auto-released. STAMPED at
  // creation — the release sweep and the reminder key on this column, never on
  // env-derived arithmetic at run time, so a knob change can't move the deadline
  // under an existing booking. Discovery bookings stamp createdAt + 24h (the
  // shipped policy); pro-created prepay stamps max(scheduledFor − 72h,
  // createdAt + 24h). Null on rows with no deposit — and on legacy rows, where
  // the sweep falls back to ageing on createdAt.
  depositDueAt                 DateTime?

  // One-time CLIENT convenience fee (cents) on a cold discovery match: 10% of the
  // deposit, floor $2, cap $10. Charged to the client ON TOP of the deposit, and
  // captured as part of the Stripe application fee on the deposit charge.
  // refundedAt is set when the fee is returned, so a fee-refunded booking stops
  // counting as an established relationship (the pair reverts to "new" and the
  // fees re-charge on a later discovery booking).
  //
  // 🔴 This column is the CLIENT's fee only — it is what the customer paid, and so
  // what the refund math may return to them. The pro's fee is proDiscoveryFeeAmount
  // and never enters the charge total. See lib/booking/discoveryFee.ts.
  discoveryFeeAmount     Int?
  discoveryFeeRefundedAt DateTime?

  // One-time PRO fee (cents) on the same cold match — $5 flat, collected OUT OF the
  // pro's deposit payout by riding in the same Stripe application fee, so the pro's
  // net is `deposit - proDiscoveryFeeAmount`. Never charged to the client.
  //
  // Both columns are written together at finalize and are the measurement record for
  // the fee model: they let discovery conversion be compared with and without fees
  // (0 across a cold match = the fees were off), and `proDiscoveryFeeWaived`
  // distinguishes a membership waiver from the fees simply being off.
  proDiscoveryFeeAmount  Int?
  proDiscoveryFeeWaived  Boolean   @default(false)

  // No-show / late-cancel fee (Phase 2 revenue protection). Charged off-session
  // against the client's default saved card and routed to the pro's connected
  // account (its OWN charge, distinct from the final bill's stripe* fields and
  // the deposit charge). Inert unless ENABLE_NO_SHOW_PROTECTION is on. Set when a
  // pro marks the booking NO_SHOW or a client cancels inside the pro's window.
  noShowMarkedAt                 DateTime?
  noShowFeeStatus                NoShowFeeStatus?
  noShowFeeAmount                Decimal?         @db.Decimal(10, 2)
  noShowFeeStripePaymentIntentId String?          @unique
  noShowFeeChargedAt             DateTime?
  // Why the fee was assessed: a pro-marked no-show vs a late cancellation.
  noShowFeeReason                NoShowFeeReason?
  // Refund / dispute reconciliation on the fee's OWN PaymentIntent (M15 GAP B),
  // mirroring the deposit's depositRefundedCents / depositDisputedAt. The fee
  // rides a separate charge, so a Stripe-side refund or chargeback never touches
  // the final-bill or deposit fields — these are the fee PI's honesty fields.
  //   - noShowFeeRefundedCents: Stripe's authoritative cumulative refund on the
  //     fee charge (integer cents). A FULL refund also flips noShowFeeStatus to
  //     REFUNDED; a sub-fee partial stays CHARGED + accumulates cents.
  //   - noShowFeeDisputedAt: set while the fee charge is under (or lost) a Stripe
  //     dispute; cleared if the dispute is WON. A disputed fee must never render
  //     as money safely collected.
  noShowFeeRefundedCents         Int              @default(0)
  noShowFeeDisputedAt            DateTime?

  // Cancellation-policy consent (M15). When a client finalizes a booking with a
  // pro who charges no-show / late-cancel fees, they must agree to the policy
  // first; we record WHEN they agreed and a SNAPSHOT of the exact terms shown.
  // The no-show fee is charged FROM this snapshot (not the pro's live settings),
  // so a pro editing their policy later can never charge more than was agreed.
  // Both null when no chargeable policy applied (the common case). Shape of the
  // snapshot: CancellationPolicySnapshot (lib/noShowProtection/policyDisclosure).
  cancellationPolicyAcceptedAt DateTime?
  cancellationPolicySnapshot   Json?

  // Client-confirmation loop (K11). Whether the CLIENT has confirmed they're
  // coming — the opposite direction from BookingStatus.PENDING, which tracks
  // the PRO's acceptance. 🔴 Deliberately orthogonal timestamps, NEVER a
  // BookingStatus value: that enum sits in the GIST overlap predicate,
  // closeout, refunds and every write-boundary guard, and a client failing to
  // confirm must never free the slot. Display state is derived in ONE place
  // (lib/booking/clientConfirmation.ts): all null = not requested; requested
  // only = awaiting client; confirmed/declined = the client's answer (latest
  // timestamp wins if both are ever set). Writers land in K12 (the token
  // actions) — as of K11 nothing stamps these, so every booking reads "not
  // requested" and no surface renders anything.
  clientConfirmationRequestedAt DateTime?
  clientConfirmedAt             DateTime?
  clientConfirmationDeclinedAt  DateTime?

  // Recurring-appointment membership (K18). 🔴 Deliberately its OWN columns,
  // never a BookingStatus value: that enum sits in the GIST overlap predicate,
  // closeout, refunds and every write guard, and a series occurrence must be an
  // ordinary appointment in every one of those paths — that is the whole reason
  // occurrences are materialized as real rows instead of virtual RRULE dates.
  // seriesOccurrenceIndex is 0-based and stable: index 0 is the slot the pro
  // picked, and the unique pair below is what makes re-materialization (K20's
  // roll-forward cron) idempotent. SetNull so removing a series can never take
  // real appointments with it.
  seriesId              String?
  seriesOccurrenceIndex Int?

  // Optional client-supplied idempotency key for booking-creation dedupe.
  // Combined with clientId in @@unique below so identical retries return
  // the existing booking instead of creating a duplicate.
  creationIdempotencyKey String?

  internalNotes String?
  clientNotes   String?

  // Pro-authored note attached to the latest booking-rule override
  // (advance notice / working hours / far future). Client-visible: shown on
  // the client's appointment detail, unlike BookingOverrideAuditLog.reason.
  clientVisibleOverrideNote String?

  client       ClientProfile                @relation(fields: [clientId], references: [id])
  professional ProfessionalProfile          @relation(fields: [professionalId], references: [id])
  service      Service                      @relation(fields: [serviceId], references: [id])
  offering     ProfessionalServiceOffering? @relation(fields: [offeringId], references: [id])

  rebookOf Booking?  @relation("RebookChain", fields: [rebookOfBookingId], references: [id])
  rebooks  Booking[] @relation("RebookChain")

  /// @deprecated Legacy. No code reads or writes through this relation. The
  /// canonical surface is `consultationApproval` + `consultationApprovalProof`
  /// for the approval workflow, and the scalar fields below for the
  /// negotiated outcome. Will be dropped in a follow-up migration after a
  /// burn-in window confirming zero database reads from the legacy table.
  /// New code is forbidden from accessing this relation — see
  /// tools/check-consultation-canonical.mjs.
  consultation               BookingConsultation?
  consultationNotes          String?
  // AEAD-encrypted envelope for the legacy negotiated-outcome consultation
  // free-text (backfill-only — no current writer; see ticket-encrypt-tier3-health-notes.md).
  consultationNotesEncrypted Json?
  consultationPrice          Decimal?                   @db.Decimal(10, 2)
  consultationConfirmedAt    DateTime?
  consultationApproval       ConsultationApproval?
  consultationApprovalProof  ConsultationApprovalProof?
  clientActionTokens         ClientActionToken[]

  aftercareSummary             AftercareSummary?
