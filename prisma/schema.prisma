model ProfessionalProfile {
  id     String @id @default(cuid())
  userId String @unique

  // The Pro's one home tenant (contract phase: required; creation sites
  // stamp it). Drives discovery visibility.
  homeTenantId String
  homeTenant   Tenant @relation("TenantHomePros", fields: [homeTenantId], references: [id], onDelete: Restrict)

  firstName       String    @default("")
  lastName        String    @default("")
  phone           String?
  phoneVerifiedAt DateTime?

  businessName       String?
  handle             String?
  handleNormalized   String?             @unique
  // Cross-table claim on the global @handle namespace. `handleNormalized`
  // above is unique only WITHIN this table; HandleRegistration is what makes it
  // unique against ClientProfile too. Always written through
  // lib/handles/registry.ts, never by hand.
  handleRegistration HandleRegistration?
  // When a not-yet-premium pro reserves a handle. Cleared once the handle goes live
  // under an active subscription; a cron releases stale non-premium reservations.
  handleReservedAt   DateTime?
  // Pro-chosen public display style; BUSINESS_NAME preserves legacy behavior.
  nameDisplay        ProNameDisplay      @default(BUSINESS_NAME)
  isPremium          Boolean             @default(false)
  clientInvites      ProClientInvite[]
  bio                String?
  avatarUrl          String?

  // Creator-page cover banner (§18): a pro-chosen portfolio photo shown as the
  // profile's cover, with a graceful branded fallback when unset (never the
  // stretched avatar). Nullable soft link to one of the pro's own MediaAssets;
  // onDelete SetNull so deleting the underlying photo simply clears the cover.
  coverMediaAssetId String?
  coverMediaAsset   MediaAsset? @relation("ProfessionalCoverMedia", fields: [coverMediaAssetId], references: [id], onDelete: SetNull)

  // Public social presence (display-only deep links; normalized without "@").
  // Instagram is the industry's #2 discovery channel — pros link their
  // portfolio identity here and the profile links back out.
  instagramHandle String?
  tiktokHandle    String?
  websiteUrl      String?

  // Display-only (public profile)
  location String @default("") // e.g. "San Diego, CA"

  // Optional fallback timezone used for new locations or display,
  // but booking math should prefer location.timeZone
  timeZone String? @db.VarChar(64)

  // Mobile travel settings (NOT calendar math)
  mobileRadiusMiles    Int?
  mobileBasePostalCode String?

  // Incremented whenever location/hours/offering config is published.
  // Availability caches can use this to detect stale entries.
  scheduleConfigVersion Int @default(0)

  // Relationships
