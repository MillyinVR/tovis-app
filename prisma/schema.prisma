  licenseNumber              String?
  licenseState               String?
  licenseExpiry              DateTime?
  licenseVerified            Boolean                              @default(false)
  verificationStatus         VerificationStatus                   @default(PENDING)
  // Pro edited their license info after approval → needs an admin re-review.
  // Separate from verificationStatus on purpose: a re-review must NOT downgrade
  // an APPROVED pro's access (only an actually-expired license does that).
  licenseReviewPending       Boolean                              @default(false)
  verificationDocs           VerificationDocument[]

  // License verification metadata (new)
  licenseVerifiedAt     DateTime?
  licenseVerifiedSource String? // "CA_DCA_BREEZE" now, later "MICROBILT", etc.
  licenseStatusCode     String? // e.g. "CURRENT", whatever DCA returns
  licenseRawJson        Json? // snapshot for audit/debug/demo (optional but powerful)

  // Social/engagement (unchanged)
  favorites       ProfessionalFavorite[] @relation("ProFavorites")
  intentEvents    ClientIntentEvent[]
  messageThreads  MessageThread[]        @relation("ProThreads")
  mediaAssets     MediaAsset[]
  practiceShots   PracticeShot[]
  waitlistEntries WaitlistEntry[]

  lookPosts LookPost[]
  followers ProFollow[]

  autoAcceptBookings Boolean @default(false)

  // Whether a CLIENT may export/share this pro's media with the pro's handle
