  lockedUntil DateTime

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([actorKey, route, key])
  @@index([status, lockedUntil])
  @@index([actorUserId, createdAt])
  @@index([actorKey, createdAt])
}

