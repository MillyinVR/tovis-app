  adminActionLogs            AdminActionLog[]               @relation("ProfessionalLogs")
  bookingOverrideAuditLogs   BookingOverrideAuditLog[]
  bookingCloseoutAuditLogs   BookingCloseoutAuditLog[]
  bookingOverridePermissions BookingOverridePermission[]    @relation("BookingOverridePermissionProfessional")
  productSales               ProductSale[]
  monthlyAnalytics           ProfessionalMonthlyAnalytics[] @relation("ProMonthlyAnalytics")
  expenses                   ProfessionalExpense[]          @relation("ProExpenses")
  receiptInbox               ProfessionalReceiptInbox[]     @relation("ProReceiptInbox")
  nfcCards                   NfcCard[]

  paymentSettings    ProfessionalPaymentSettings?
  noShowSettings     ProNoShowSettings?
  reminderSettings   ProReminderSettings?
  subscription       ProfessionalSubscription?
  lastMinuteSettings LastMinuteSettings?          @relation("ProLastMinuteSettings")
  lastMinuteOpenings LastMinuteOpening[]          @relation("ProOpenings")

  holds BookingHold[] @relation("ProHolds") // name optional but makes it clear

  clientNotes                 ClientProfessionalNote[]
  clientPolicies              ProClientPolicy[]
  clientChartShares           ClientChartShare[]
  bookingSeries               BookingSeries[]
  clientFormulaEntries        ClientFormulaEntry[]
  clientConsentRecords        ClientConsentRecord[]
  consentForms                ConsentForm[]
  recordedAllergies           ClientAllergy[] // for recordedBy relation
  reviews                     Review[]
  reminders                   Reminder[]
  viralRequestApprovalFanOuts ViralRequestApprovalFanOut[]

