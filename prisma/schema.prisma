}

// ALLOW grants a service to a (profession, state); DENY removes it. DENY lets
// "allowed in every state except X" be a baseline ALLOW (stateCode null) plus
// one DENY row, instead of a per-state ALLOW for every other jurisdiction.
enum ServicePermissionMode {
  ALLOW
  DENY
}

model ServicePermission {
  id             String                @id @default(cuid())
  serviceId      String
  professionType ProfessionType
  stateCode      String?
  mode           ServicePermissionMode @default(ALLOW)

  service Service @relation(fields: [serviceId], references: [id])

  @@index([professionType, stateCode])
}

model ProfessionalServiceOffering {
  id             String @id @default(cuid())
  professionalId String
  serviceId      String

  title       String?
  description String?

  // Prices/durations per booking mode
  salonPriceStartingAt  Decimal? @db.Decimal(10, 2)
  salonDurationMinutes  Int?
  mobilePriceStartingAt Decimal? @db.Decimal(10, 2)
  mobileDurationMinutes Int?

  // Mode flags per service.
  //
  // W6: `offersInSalon` used to be `@default(true)`. A mode the pro never chose
  // is not a fact about their business — it advertised in-salon booking (and the
  // salon waitlist) for pros who only travel, and made
  // `ensureLocationsForOffering` auto-write a "Set salon address" placeholder
  // location to back the claim up. Both modes now default OFF; every writer
  // states the modes explicitly, and the client-facing read boundary
  // (lib/offerings/locationCapability.ts) narrows them to what the pro has a
  // bookable location for.
  offersInSalon Boolean @default(false)
  offersMobile  Boolean @default(false)

  // Typical rebook interval for this offering, in days, set by the pro. When
  // present, session wrap-up (aftercare) auto-suggests a recommended-window
  // rebook date = service date + this many days. Null = no suggestion (the
  // rebook recommendation stays "None", the pre-existing behavior).
  rebookIntervalDays Int?

  /// K8: the pro's calendar colour for THIS service — one of the twelve
  /// `--swatch-01`…`--swatch-12` brand tokens (`CALENDAR_SWATCH_IDS`), painted
  /// on the event card's accent stripe. Null = no service colour, and the
  /// stripe keeps the booking's status tone. Stored here, on the pro↔service
  /// join, because `Service` is a global catalog row shared by every pro.
  /// Read through `parseCalendarSwatch`, never raw: a value outside the current
  /// palette must degrade to "no colour", not to a broken attribute.
  calendarSwatch String?

  /// K10: this service must be PAID IN FULL up front (D4 = per-service). Null =
  /// no prepay requirement, and the booking follows the pro's account-wide
  /// `ProfessionalPaymentSettings.depositScope` exactly as before.
  ///
  /// 🔴 A non-null value OVERRIDES the account-wide `depositEnabled` switch
  /// (Tori, 2026-07-30): a pro with deposits off who marks one service
  /// prepay-required gets prepay on it. The Stripe-ready gate still applies —
  /// a pro who cannot receive a charge would only strand the booking with a
  /// deposit nobody can pay. See lib/booking/depositRequirement.ts.
  prepayScope OfferingPrepayScope?

  /// K15: this service requires a signed consent form. Points at the FORM, not
  /// a version — the version is resolved when the signature request is sent,
  /// which is what makes K14's append-only model do its job: a pro who edits
  /// the waiver changes what future clients sign, and changes nothing about
  /// what past clients already signed.
  ///
  /// 🔴 v1 WARNS, it does not BLOCK. Nothing on the booking path consults this
  /// column; it feeds the pro-facing "waiver not signed" marks on the calendar
  /// card and at session start. Refusing bookings on an unsigned waiver would
  /// strand real appointments the day a pro sets their first requirement.
  ///
  /// Restrict, not SetNull: a requirement that silently disappears when a form
  /// is deleted stops clients being asked to sign, with nothing on any surface
  /// to say so. Unbinding is the pro's explicit act.
  consentFormId String?

  customImageUrl String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id])
  service      Service             @relation(fields: [serviceId], references: [id])
  consentForm  ConsentForm?        @relation("OfferingConsentRequirement", fields: [consentFormId], references: [id], onDelete: Restrict)

  bookings Booking[]

  // (keep your other relations if you use them)
  messageThreads      MessageThread[]      @relation("OfferingThreads")
  quotes              Quote[]              @relation("OfferingQuotes")
  intentEvents        ClientIntentEvent[]
  bookingServiceItems BookingServiceItem[]
  holds               BookingHold[]

  addOns OfferingAddOn[]

  aftercareRebookSlots AftercareRebookSlot[]
  waitlistOffers       WaitlistOffer[]

  lastMinuteOpeningServices LastMinuteOpeningService[]
  priceRamps                OfferingPriceRamp[]
  bookingSeries             BookingSeries[]

  @@unique([professionalId, serviceId])
  @@index([professionalId, isActive])
  // K15 — "which of my services require this form", and the FK's own lookups.
  @@index([consentFormId])
}

/// Price-grace ramp for an offering whose price the pro set BELOW the catalog
/// minimum. New clients are always quoted the catalog minimum; existing clients
/// are grandfathered at `currentPrice`, which a scheduled job steps up toward
/// `targetPrice` (the catalog minimum at ramp start) on the chosen cadence.
/// One ramp per offering per booking mode — a salon and mobile price can each be
/// below minimum independently. See docs/design/pro-migration-import.md.
model OfferingPriceRamp {
  id                 String              @id @default(cuid())
  offeringId         String
  mode               ServiceLocationType
  grandfatheredPrice Decimal             @db.Decimal(10, 2)
  targetPrice        Decimal             @db.Decimal(10, 2)
  currentPrice       Decimal             @db.Decimal(10, 2)
  stepMode           RaiseStepMode
  stepValue          Decimal             @db.Decimal(10, 2)
  cadenceWeeks       Int
  startedAt          DateTime            @default(now())
  nextStepAt         DateTime
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  offering ProfessionalServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([offeringId, mode])
  @@index([completedAt, nextStepAt])
}

enum CalendarFeedStatus {
  ACTIVE // resynced on the cron
  PAUSED // pro disconnected; kept for history, not resynced
  ERROR // last sync failed (e.g. feed unreachable); still retried
}

// A pro's read-only competitor calendar feed, kept in sync during migration.
// One per pro. The resync cron re-fetches + re-imports (idempotent on event UID).
model CalendarFeedSubscription {
  id             String             @id @default(cuid())
  professionalId String             @unique
  feedUrl        String
  status         CalendarFeedStatus @default(ACTIVE)
  lastSyncedAt   DateTime?
