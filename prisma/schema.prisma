// =======================
// CORE MODELS
// =======================
model Notification {
  id String @id @default(cuid())

  eventKey NotificationEventKey
  priority NotificationPriority @default(NORMAL)

  professionalId String
  // Tenant of the recipient pro (derived from professional.homeTenantId).
  // Expand phase: nullable + backfilled; contract migration makes it NOT NULL.
  proTenantId    String?
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  proTenant      Tenant?             @relation("TenantNotifications", fields: [proTenantId], references: [id], onDelete: Restrict)

  actorUserId String?
  actorUser   User?   @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  reviewId String?
  review   Review? @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  title String
  body  String @default("")
  href  String @default("")

  // structured payload for UI + future-proofing
  data Json?

  dedupeKey String?

  // state
  seenAt     DateTime?
  readAt     DateTime?
  clickedAt  DateTime?
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dispatches                  NotificationDispatch[]       @relation("ProNotificationDispatches")
  viralRequestApprovalFanOuts ViralRequestApprovalFanOut[]

  @@unique([professionalId, dedupeKey])
  // main inbox query
  @@index([professionalId, archivedAt, readAt, createdAt])
  // filters
  @@index([professionalId, eventKey, archivedAt, createdAt])
  @@index([professionalId, priority, archivedAt, createdAt])
  @@index([bookingId])
  @@index([reviewId])
  @@index([proTenantId])
}

// Admin operational-alert inbox. Keyed by the admin User (every user with role
// ADMIN gets their own row), mirroring the pro/client inbox shape. There is no
// admin-preference table yet: admins receive the event's default channels
// (in-app + email; never SMS) with no quiet-hours suppression.
model AdminNotification {
  id          String @id @default(cuid())
  adminUserId String

  eventKey NotificationEventKey
  priority NotificationPriority @default(NORMAL)

  title String
  body  String @default("")
  href  String @default("")

  // structured payload for UI + future-proofing
  data Json?

  dedupeKey String?

  // state
  seenAt     DateTime?
  readAt     DateTime?
  clickedAt  DateTime?
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminUser  User                   @relation("AdminNotifications", fields: [adminUserId], references: [id], onDelete: Cascade)
  dispatches NotificationDispatch[] @relation("AdminInboxNotificationDispatches")

  @@unique([adminUserId, dedupeKey])
  // main inbox query
  @@index([adminUserId, archivedAt, readAt, createdAt])
  // filters
  @@index([adminUserId, eventKey, archivedAt, createdAt])
}

model NotificationDispatch {
  id String @id @default(cuid())

  // stable idempotency key for the source of this dispatch
  // examples:
  //   pro-notification:<notificationId>
  //   client-notification:<clientNotificationId>
  //   scheduled-client:<scheduledNotificationId>
  //   booking:<bookingId>:reminder:24h
  sourceKey String @unique

  eventKey      NotificationEventKey
  recipientKind NotificationRecipientKind
  priority      NotificationPriority      @default(NORMAL)

  userId         String?
  professionalId String?
  clientId       String?

  // durable recipient snapshot for delivery-time policy, audit, and retries
  recipientInAppTargetId String? @db.VarChar(64)
  recipientPhone         String? @db.VarChar(32)
  recipientEmail         String? @db.VarChar(320)
  recipientTimeZone      String? @db.VarChar(64)

  // optional links back to product-facing inbox records
  notificationId       String?
  clientNotificationId String?
  adminNotificationId  String?

  title   String
  body    String @default("")
  href    String @default("")
  payload Json?

  scheduledFor DateTime  @default(now())
  cancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?                @relation("UserNotificationDispatches", fields: [userId], references: [id], onDelete: SetNull)
  professional ProfessionalProfile? @relation("ProfessionalNotificationDispatches", fields: [professionalId], references: [id], onDelete: Cascade)
  client       ClientProfile?       @relation("ClientProfileNotificationDispatches", fields: [clientId], references: [id], onDelete: Cascade)

  notification       Notification?       @relation("ProNotificationDispatches", fields: [notificationId], references: [id], onDelete: SetNull)
  clientNotification ClientNotification? @relation("ClientInboxNotificationDispatches", fields: [clientNotificationId], references: [id], onDelete: SetNull)
  adminNotification  AdminNotification?  @relation("AdminInboxNotificationDispatches", fields: [adminNotificationId], references: [id], onDelete: SetNull)

  deliveries                  NotificationDelivery[]
  viralRequestApprovalFanOuts ViralRequestApprovalFanOut[]

  @@index([recipientKind, scheduledFor, createdAt])
  @@index([professionalId, createdAt])
  @@index([clientId, createdAt])
  @@index([userId, createdAt])
  @@index([notificationId])
  @@index([clientNotificationId])
  @@index([adminNotificationId])
}

model NotificationDelivery {
  id String @id @default(cuid())

  dispatchId String
  channel    NotificationChannel
  provider   NotificationProvider

  status NotificationDeliveryStatus @default(PENDING)

  // destination snapshot used at send time
  destination     String?
  templateKey     String
  templateVersion Int     @default(1)

  attemptCount Int @default(0)
  maxAttempts  Int @default(5)

  nextAttemptAt DateTime  @default(now())
  lastAttemptAt DateTime?

  claimedAt      DateTime?
  leaseExpiresAt DateTime?
  leaseToken     String?

  providerMessageId String?
  providerStatus    String?

  lastErrorCode    String?
  lastErrorMessage String?

  sentAt       DateTime?
  deliveredAt  DateTime?
  failedAt     DateTime?
  suppressedAt DateTime?
  cancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dispatch NotificationDispatch        @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  events   NotificationDeliveryEvent[]

  @@unique([dispatchId, channel, destination])
  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
  @@index([provider, providerMessageId])
}

model NotificationDeliveryEvent {
  id String @id @default(cuid())

  deliveryId    String
  attemptNumber Int?

  type       NotificationDeliveryEventType
  fromStatus NotificationDeliveryStatus?
  toStatus   NotificationDeliveryStatus?

  providerStatus    String?
  providerMessageId String?

  errorCode    String?
  errorMessage String?
  message      String?

  payload Json?

  createdAt DateTime @default(now())

  delivery NotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, createdAt])
  @@index([type, createdAt])
}

model ProfessionalNotificationPreference {
  id             String               @id @default(cuid())
  professionalId String
  eventKey       NotificationEventKey

  inAppEnabled Boolean @default(true)
  smsEnabled   Boolean @default(false)
  emailEnabled Boolean @default(true)
  pushEnabled  Boolean @default(true)

  quietHoursStartMinutes Int?
  quietHoursEndMinutes   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, eventKey])
  @@index([professionalId, updatedAt])
}

model ClientNotificationPreference {
  id       String               @id @default(cuid())
  clientId String
  eventKey NotificationEventKey

  inAppEnabled Boolean @default(true)
  smsEnabled   Boolean @default(true)
  emailEnabled Boolean @default(true)
  pushEnabled  Boolean @default(true)

  quietHoursStartMinutes Int?
  quietHoursEndMinutes   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, eventKey])
  @@index([clientId, updatedAt])
}

// A registered push-notification target for one user's device/install. Native
// apps register their APNs/FCM token here on launch (and after refresh); the
// notification engine fans a PUSH delivery out to all of a user's active tokens
// (wired in a later phase). A token is globally unique to one install, so it is
// reassigned to the current user on re-login rather than duplicated.
model DeviceToken {
  id     String @id @default(cuid())
  userId String

  platform DevicePlatform
  token    String         @db.VarChar(512)

  // Optional stable per-install id from the client (survives token refresh).
  deviceId String? @db.VarChar(128)

  isActive   Boolean   @default(true)
  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserDeviceTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, token])
  @@index([userId, isActive])
}

enum DevicePlatform {
  IOS
  ANDROID
}

/// Per-device session revocation. The auth session is a stateless JWT keyed only
/// by the per-user `authVersion` (bumping it kills EVERY session). To revoke a
/// single lost/stolen device without signing the user out everywhere, a native
/// session token also carries a stable `deviceId` claim; revoking sets
/// `revokedAt` here and `getCurrentUser` rejects any token for that
/// `(userId, deviceId)` whose issued-at (`iat`) is at or before `revokedAt`. A
/// later re-login mints a fresher token that passes again, so one row per device
/// (upserted) is enough — no per-token bookkeeping.
model DeviceSessionRevocation {
  id     String @id @default(cuid())
  userId String

  // Matches DeviceToken.deviceId (the stable per-install id the client sends).
  deviceId String @db.VarChar(128)

  // Tokens for this device issued at or before this instant are rejected.
  revokedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserDeviceSessionRevocations", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
}

model ConsultationApproval {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status     ConsultationApprovalStatus @default(PENDING)
  approvedAt DateTime?
  rejectedAt DateTime?

  proposedServicesJson Json
  proposedTotal        Decimal?
  notes                String?

  // AEAD-encrypted envelope for the consultation free-text (expand→contract
  // dual-write; see docs/security/ticket-encrypt-tier3-health-notes.md).
  notesEncrypted Json?

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  clientId String?
  proId    String?

  proof              ConsultationApprovalProof?
  clientActionTokens ClientActionToken[]

  @@index([status])
}

model ClientActionToken {
  id String @id @default(cuid())

  kind      ClientActionTokenKind
  tokenHash String                @unique @db.VarChar(128)
  singleUse Boolean               @default(true)

  bookingId              String
  consultationApprovalId String?
  aftercareSummaryId     String?
  // K15 — the exact consent text this signature link puts in front of the
  // client, pinned when the link is MINTED. The signing route writes this same
  // id onto the record, so publishing a new version between the send and the
  // signature cannot change which words the record attests to. Resolving
  // `max(version)` at signing time instead would silently re-point it.
  consentFormVersionId   String?
  clientId               String
  professionalId         String

  deliveryMethod         ContactMethod?
  recipientEmailSnapshot String?        @db.VarChar(320)
  recipientPhoneSnapshot String?        @db.VarChar(32)

  issuedByUserId String?

  expiresAt   DateTime
  firstUsedAt DateTime?
  lastUsedAt  DateTime?
  useCount    Int       @default(0)

  revokedAt    DateTime?
  revokeReason String?

  metadata Json?

  booking              Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  consultationApproval ConsultationApproval? @relation(fields: [consultationApprovalId], references: [id], onDelete: Cascade)
  aftercareSummary     AftercareSummary?     @relation(fields: [aftercareSummaryId], references: [id], onDelete: Cascade)
  consentFormVersion   ConsentFormVersion?   @relation("ConsentSignatureTokenVersion", fields: [consentFormVersionId], references: [id], onDelete: Cascade)
  consentRecord        ClientConsentRecord?  @relation("ConsentSignatureTokenRecord")
  client               ClientProfile         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professional         ProfessionalProfile   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  issuedByUser         User?                 @relation("IssuedClientActionTokens", fields: [issuedByUserId], references: [id], onDelete: SetNull)

  proof ConsultationApprovalProof? @relation("ConsultationProofActionToken")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, expiresAt])
  @@index([bookingId, kind, createdAt])
  @@index([consultationApprovalId, kind, createdAt])
  @@index([aftercareSummaryId, kind, createdAt])
  @@index([clientId, kind, createdAt])
  @@index([professionalId, kind, createdAt])
  @@index([issuedByUserId, createdAt])
  @@index([consentFormVersionId, kind, createdAt])
}

model ConsultationApprovalProof {
  id String @id @default(cuid())

  consultationApprovalId String @unique
  bookingId              String @unique
  clientId               String
  professionalId         String

  decision ConsultationDecision
  method   ConsultationApprovalProofMethod

  actedAt DateTime @default(now())

  recordedByUserId    String?
  clientActionTokenId String? @unique

  contactMethod       ContactMethod?
  destinationSnapshot String?        @db.VarChar(320)
  ipAddress           String?        @db.VarChar(64)
  userAgent           String?
  contextJson         Json?

  consultationApproval ConsultationApproval @relation(fields: [consultationApprovalId], references: [id], onDelete: Cascade)
  booking              Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  client               ClientProfile        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professional         ProfessionalProfile  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  recordedByUser       User?                @relation("RecordedConsultationApprovalProofs", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  clientActionToken    ClientActionToken?   @relation("ConsultationProofActionToken", fields: [clientActionTokenId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, actedAt])
  @@index([professionalId, actedAt])
  @@index([method, actedAt])
  @@index([decision, actedAt])
  @@index([recordedByUserId, actedAt])
}

model AdminPermission {
  id String @id @default(cuid())

  adminUserId String
  role        AdminPermissionRole @default(SUPPORT)

  // Option A scopes (all optional)
  professionalId String?
  serviceId      String?
  categoryId     String?

  createdAt DateTime @default(now())

  adminUser    User                 @relation(fields: [adminUserId], references: [id])
  professional ProfessionalProfile? @relation(fields: [professionalId], references: [id])
  service      Service?             @relation(fields: [serviceId], references: [id])
  category     ServiceCategory?     @relation(fields: [categoryId], references: [id])

