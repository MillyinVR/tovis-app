  intentEvents                 ClientIntentEvent[]
  lastMinuteOpeningServices    LastMinuteOpeningService[]
  lastMinuteTierFreeAddOnPlans LastMinuteTierPlan[]       @relation("LastMinuteTierPlanFreeAddOnService")

