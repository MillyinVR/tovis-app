model User {
  id                  String    @id @default(cuid())
  email               String    @unique @db.VarChar(320)
  emailHashV2         String?   @unique @db.VarChar(128)
  emailHashKeyVersion Int?
  // AEAD-encrypted envelope for the displayable email (expand→contract dual-write;
  // mirrors phoneEncrypted). The plaintext `email` column above remains the source
  // of truth during burn-in and is dropped in the contract migration; the lookup
  // hash (emailHashV2) is the separate, untouched query anchor.
  emailEncrypted      Json?
  phone               String?   @unique @db.VarChar(32)
  phoneHashV2         String?   @unique @db.VarChar(128)
  phoneHashKeyVersion Int?
  // AEAD-encrypted envelope for the displayable phone (expand→contract dual-write;
  // see docs/security/ticket-encrypt-phone-at-rest.md). The plaintext column above
  // remains during burn-in and is dropped in the contract migration. The lookup
  // hash (phoneHashV2) is the separate, untouched query anchor.
  phoneEncrypted      Json?
  phoneVerifiedAt     DateTime?
  emailVerifiedAt     DateTime?

  // Set when Postmark reports the address as inactive/suppressed (hard
  // bounce, spam complaint, or manual suppression, ErrorCode 406). Excludes
  // the user from verification-email retry sweeps.
  emailSendPermanentlyFailedAt DateTime?

  lookLikes                 LookLike[]
  lookHides                 LookHide[]
  lookViewerImpressionStats LookViewerImpressionStat[]
  lookComments              LookComment[]
  lookCommentLikes          LookCommentLike[]

  lookPostReports    LookPostReport[]
  lookCommentReports LookCommentReport[]

  reviewedLookPosts          LookPost[]                  @relation("LookPostReviewedByUser")
  reviewedLookComments       LookComment[]               @relation("LookCommentReviewedByUser")
  viralServiceRequestReports ViralServiceRequestReport[]

  tosAcceptedAt DateTime?
  tosVersion    String?

  transactionalSmsConsentAt        DateTime?
  transactionalSmsConsentVersion   String?   @db.VarChar(64)
  transactionalSmsConsentSource    String?   @db.VarChar(64)
  transactionalSmsConsentIp        String?   @db.VarChar(64)
  transactionalSmsConsentUserAgent String?

  authVersion        Int                        @default(1)
  loginAttempts      Int                        @default(0)
  lockedUntil        DateTime?
  password           String
  // Apple "Sign in with Apple" stable user id (the identity-token `sub`). Null
  // for password/other users; set when an account is linked to an Apple id.
  appleUserId        String?                    @unique @db.VarChar(255)
  // Google Sign-In stable user id (the OIDC id-token `sub`). Null for
  // password/other users; set when an account is linked to a Google identity.
  googleUserId       String?                    @unique @db.VarChar(255)
  role               Role
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  reviewHelpfulVotes ReviewHelpful[]
  favoriteServices   ServiceFavorite[]
  adminActionLogs    AdminActionLog[]           @relation("AdminUserLogs")
  adminPermissions   AdminPermission[]
  sentMessages       Message[]                  @relation("UserSentMessages")
  threadParticipants MessageThreadParticipant[] @relation("UserThreadParticipants")

  notificationActor                  Notification[]              @relation("NotificationActor")
  adminNotifications                 AdminNotification[]         @relation("AdminNotifications")
  notificationDispatches             NotificationDispatch[]      @relation("UserNotificationDispatches")
  deviceTokens                       DeviceToken[]               @relation("UserDeviceTokens")
  deviceSessionRevocations           DeviceSessionRevocation[]   @relation("UserDeviceSessionRevocations")
  issuedClientActionTokens           ClientActionToken[]         @relation("IssuedClientActionTokens")
  recordedConsultationApprovalProofs ConsultationApprovalProof[] @relation("RecordedConsultationApprovalProofs")
  bookingOverrideAuditLogs           BookingOverrideAuditLog[]   @relation("BookingOverrideActor")
  acceptedProClientInvites           ProClientInvite[]           @relation("ProClientInviteAcceptedByUser")
  revokedProClientInvites            ProClientInvite[]           @relation("ProClientInviteRevokedByUser")

  bookingOverridePermissionsGranted BookingOverridePermission[] @relation("BookingOverridePermissionGrantedBy")
  bookingOverridePermissionsRevoked BookingOverridePermission[] @relation("BookingOverridePermissionRevokedBy")
  bookingOverridePermissionsAsActor BookingOverridePermission[] @relation("BookingOverridePermissionActor")

  bookingCloseoutAuditLogs BookingCloseoutAuditLog[] @relation("BookingCloseoutActor")
  createdBookingSeries     BookingSeries[]
  idempotencyKeys          IdempotencyKey[]          @relation("UserIdempotencyKeys")

  accountDeletionRequests AccountDeletionRequest[] @relation("UserAccountDeletionRequests")

  // NFC attribution events
  attributionActorEvents    AttributionEvent[] @relation("AttributionActor")
  attributionCreditedEvents AttributionEvent[] @relation("AttributionCredited")

  // favorites (clients favoriting pros)
  favoritePros ProfessionalFavorite[]

  // role profiles
  clientProfile       ClientProfile?
  professionalProfile ProfessionalProfile?

  // media interactions
  mediaLikes    MediaLike[]
  mediaComments MediaComment[]

  // opposite relation for MediaAsset.uploadedByUser
  uploadedMedia           MediaAsset[]             @relation("UploadedMedia")
  nfcCards                NfcCard[]
  tapIntents              TapIntent[]
  passwordResetTokens     PasswordResetToken[]
  phoneVerifications      PhoneVerification[]
  emailVerificationTokens EmailVerificationToken[]
  sessionHandoffTokens    SessionHandoffToken[]

  supportTicketsCreated SupportTicket[]        @relation("SupportTicketCreatedBy")
  supportTicketsHandled SupportTicket[]        @relation("SupportTicketHandledBy")
  verificationDocuments VerificationDocument[]
  viralServiceRequests  ViralServiceRequest[]  @relation("ViralServiceRequestReviewedByUser")

  @@index([emailHashKeyVersion])
  @@index([phoneHashKeyVersion])
}

model IdempotencyKey {
  id String @id @default(cuid())

  actorUserId String?
  actor       User?   @relation("UserIdempotencyKeys", fields: [actorUserId], references: [id], onDelete: SetNull)

  actorKey  String @db.VarChar(191)
  actorRole Role

  route String @db.VarChar(191)
  key   String @db.VarChar(191)

