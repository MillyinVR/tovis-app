/// How a pro's no-show / late-cancel fee is computed. Mirrors DepositType.
enum NoShowFeeType {
  FLAT // a fixed dollar amount (feeFlatAmount)
  PERCENT // a percentage of the booking total (feePercent, 1–100)
}

/// Which event triggered a booking's no-show / late-cancel fee.
enum NoShowFeeReason {
  NO_SHOW // pro marked the booking as a no-show
  LATE_CANCEL // client cancelled inside the pro's cancel window
}

/// Outcome of a no-show / late-cancel fee off-session charge. Recorded on the
/// Booking so the client and pro can see whether the saved card was actually
/// billed. Phase 2 revenue protection; inert unless ENABLE_NO_SHOW_PROTECTION.
enum NoShowFeeStatus {
  // Fee was owed but no charge was attempted (e.g. client had no card on file).
  SKIPPED
  CHARGED // off-session PaymentIntent succeeded
  FAILED // Stripe declined / authentication required off-session
  WAIVED // pro/admin forgave the fee after the fact
  // A CHARGED fee that was FULLY refunded on its own PaymentIntent (in-app or via
  // the Stripe Dashboard). A sub-fee partial refund stays CHARGED and accumulates
  // noShowFeeRefundedCents instead — mirrors BookingDepositStatus.REFUNDED.
  REFUNDED
}

/// Per-pro (account-level) no-show / late-cancel fee policy (Phase 2 revenue
/// protection). One row per professional; created lazily on first save. Inert
/// unless ENABLE_NO_SHOW_PROTECTION is on — nothing charges a card while the
/// flag is dark. The fee is charged off-session against the client's default
/// saved card and routed to the pro's connected account, mirroring the
/// destination charge on client checkout.
model ProNoShowSettings {
  id             String @id @default(cuid())
  professionalId String @unique

  // Master opt-in. While false the pro never charges a no-show/late-cancel fee.
  enabled Boolean @default(false)

  // Fee shape (pro's choice: flat dollar amount or percent of booking total).
  feeType       NoShowFeeType @default(FLAT)
  feeFlatAmount Decimal?      @db.Decimal(10, 2)
  feePercent    Int? // 1–100 when feeType = PERCENT

  // Hours before the scheduled start inside which a client cancellation counts
  // as a "late cancel" and is billable. Locked to 24 at launch; stored so the
  // window is configurable later without a migration.
  cancelWindowHours Int @default(24)

  // Which events actually bill: a pro-marked no-show, and/or a client cancel
  // inside the window. Both default on when the pro opts in.
  chargeNoShow     Boolean @default(true)
  chargeLateCancel Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
}

/// Per-pro (account-level) appointment-reminder cadence. One row per pro,
/// created lazily on first save. Configures WHICH client reminders fire ahead of
/// a booking; each value in `offsetDays` schedules one reminder that many days
/// before the appointment (7 = one week, 3 = three days, 1 = day before). The
/// scheduling spine (lib/notifications/appointmentReminders.ts) reads this to
/// plan reminders on the shared ScheduledClientNotification queue; quiet-hours
/// and dedupe are handled downstream by the dispatch layer. Missing row => the
/// default cadence below applies, so reminders keep working without a saved row.
model ProReminderSettings {
  id             String @id @default(cuid())
  professionalId String @unique

  // Master opt-in. While false, no appointment reminders are scheduled for this
  // pro's bookings. Reminders default ON so every pro sends them out of the box.
  enabled Boolean @default(true)

  // Lead times (minutes before the appointment) to send a reminder at. Any lead
  // is allowed — a whole-day lead is a multiple of 1440 and fires at the
  // appointment's own local wall-clock time N days earlier (DST-safe); a sub-day
  // lead fires exactly that many minutes before the appointment instant. Bounds
  // (min/max/granularity/count) are enforced in lib/reminderSettings/settings.ts.
  // Default cadence: one week + three days + day before (10080 / 4320 / 1440).
  offsetMinutes Int[] @default([10080, 4320, 1440])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
}

// Catalog of membership tiers (Free / Pro / Studio). Pricing + Stripe Billing IDs
// live here; the entitlement matrix that actually gates features is code-defined in
// lib/pro/entitlements.ts (keyed by `key`), so gating works without seeded rows.
model SubscriptionPlan {
  id              String   @id @default(cuid())
  key             String   @unique // "free" | "pro" | "studio"
  name            String
  priceCents      Int      @default(0)
  interval        String? // "month" | "year" — null for free
  stripeProductId String?
  stripePriceId   String? // null for free
  features        Json? // display copy; NOT the gating source of truth
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// A pro's current membership. Missing row => free plan. The Billing customer id is
// DISTINCT from the Connect account id on ProfessionalPaymentSettings — a pro is both
// a connected account (receives client money) and a customer (pays Tovis).
model ProfessionalSubscription {
  id             String @id @default(cuid())
  professionalId String @unique

  planKey String             @default("free")
  status  SubscriptionStatus @default(ACTIVE)

  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  trialEndsAt          DateTime?

  // Admin-granted complimentary membership ("free months"). Lives BESIDE the
  // paid Stripe state — webhooks never write these fields, so a comp survives
  // real-subscription churn. Entitlements resolve to the better of paid vs
  // comp while compUntil is in the future; the comp-expiry job clears expired
  // comps and recomputes the isPremium backfill.
  compPlanKey         String?
  compUntil           DateTime?
  compNote            String?
  compGrantedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([planKey])
  @@index([status])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([compUntil])
}

model ProfessionalLocation {
  id             String @id @default(cuid())
  professionalId String

  type       ProfessionalLocationType
  name       String?
  isPrimary  Boolean                  @default(false)
  isBookable Boolean                  @default(true)

  /// W7: may this location's EXACT address be published to an unauthenticated
  /// audience — Discover, `/api/v1/search/pros`, `/api/v1/pros/nearby`?
  ///
  /// Default OFF for every location type, SALON included. A pro whose "salon" is
  /// really a home studio must never be exposed by an inference about their
  /// location type; publishing an address is an act, not a side effect of
  /// picking SALON in a dropdown.
  ///
  /// When false (or when the location has no address, or isn't bookable), the
  /// public preview keeps today's redaction: `formattedAddress` and `placeId`
  /// null, coordinates coarsened to ~1.1km. That redaction is why Discover's
  /// Navigate button routed to a fuzzed point and "snapped to the nearest
  /// building" — the button was built on deliberately-inaccurate data. Navigate
  /// now renders only when this flag let a real address through.
  isAddressPublic Boolean @default(false)

  // Address (SALON/SUITE required; MOBILE_BASE optional)
  formattedAddress String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  countryCode      String?
  placeId          String?

  // Geo
  lat Decimal? @db.Decimal(10, 7)
  lng Decimal? @db.Decimal(10, 7)

  // Address encryption expansion fields.
  // Keep raw fields during expand/dual-write/backfill phase.
  encryptedAddressJson Json?
  addressKeyVersion    String?   @db.VarChar(32)
  postalCodePrefix     String?   @db.VarChar(12)
  latApprox            Decimal?  @db.Decimal(8, 4)
  lngApprox            Decimal?  @db.Decimal(8, 4)
  encryptedAt          DateTime?

  // ✅ Source of truth for booking timezone
  timeZone String? @db.VarChar(64)

  // ✅ Source of truth for calendar hours
  // { "mon": { "enabled": true, "start": "09:00", "end": "17:00" }, ... }
  workingHours Json

  // Location-level booking defaults
  bufferMinutes        Int @default(15)
  stepMinutes          Int @default(30)
  advanceNoticeMinutes Int @default(15)
  maxDaysAhead         Int @default(365)

  // Soft-delete. A pro can "remove" a location even when historical bookings
  // still reference it (FK is Restrict). Referenced locations are archived
  // (hidden everywhere the pro manages/publishes/books) rather than hard-deleted
  // so booking history and FK integrity are preserved. Locations with no
  // references are hard-deleted and never get an archivedAt.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  bookings           Booking[]
  holds              BookingHold[]
  blocks             CalendarBlock[]
  lastMinuteOpenings LastMinuteOpening[]

  searchIndexEntry ProfessionalSearchIndex?

  aftercareRebookSlots AftercareRebookSlot[]
  waitlistOffers       WaitlistOffer[]
  bookingSeries        BookingSeries[]

  @@index([placeId])
  @@index([professionalId])
  @@index([professionalId, isPrimary])
  @@index([professionalId, isBookable])
  @@index([professionalId, archivedAt])
  @@index([lat, lng])
  @@index([isBookable, type, lat, lng])
  @@index([postalCodePrefix])
  @@index([latApprox, lngApprox])
  @@index([addressKeyVersion])
}

// P2.4a foundation — denormalized search/discovery index.
//
// One row per ProfessionalLocation; refreshed by hooks in mutation
// routes (locations, working-hours, offerings) via
// `lib/search/index/refreshSearchIndex.ts`. The `geom` column is a
// PostGIS `geography(Point, 4326)` — Prisma cannot model it natively,
// so all upserts go through raw SQL helpers. Reads via the typed
// Prisma client work for every column EXCEPT `geom`; geo radius
// queries use raw SQL with `ST_DWithin`.
//
// This table is dark-loaded in P2.4a — population happens on every
// mutation, but `searchPros` and `loadNearbyPros` still query the
// source tables. P2.4b will swap the read paths to this index.
model ProfessionalSearchIndex {
  // 1:1 with a ProfessionalLocation (PK + FK).
  locationId     String @id
  professionalId String

  // Geography column — created by raw SQL in the migration; written
  // exclusively via $executeRaw in refreshLocation/refreshProfessional.
  // Typed Prisma writes against this column will throw at runtime.
  geom Unsupported("geography(Point, 4326)")
  lat  Decimal                               @db.Decimal(10, 7)
  lng  Decimal                               @db.Decimal(10, 7)

  // Pro-level filter columns (denormalized from ProfessionalProfile).
  verificationStatus VerificationStatus
  professionType     ProfessionType?
  businessName       String?
  // Pre-resolved public display name (honors ProfessionalProfile.nameDisplay),
  // written by refreshSearchIndex so search results don't re-resolve per row.
  displayName        String?
  handle             String?
  handleNormalized   String?
  avatarUrl          String?
  mobileRadiusMiles  Int?

  // Location-level filter columns (denormalized from ProfessionalLocation).
  locationType     ProfessionalLocationType
  isPrimary        Boolean
  isBookable       Boolean
  city             String?
  state            String?
  formattedAddress String?
  timeZone         String?
  workingHours     Json

  // Offering rollups (denormalized from ProfessionalServiceOffering joined to Service).
  // Arrays enable GIN-indexed `category_id = ANY(category_ids)` filters.
  categoryIds    String[]
  serviceIds     String[]
  offersInSalon  Boolean  @default(false)
  offersMobile   Boolean  @default(false)
  minSalonPrice  Decimal? @db.Decimal(10, 2)
  minMobilePrice Decimal? @db.Decimal(10, 2)
  minAnyPrice    Decimal? @db.Decimal(10, 2)

  // Rating rollup (denormalized from Review.groupBy).
  ratingAvg   Float?
  ratingCount Int    @default(0)

  // Bookkeeping for debugging stale rows.
  refreshedAt   DateTime @default(now()) @updatedAt
  refreshSource String?

  professional ProfessionalProfile  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  location     ProfessionalLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  // GIST and GIN indexes are created in raw SQL in the migration.

  @@index([professionalId])
  @@index([verificationStatus, isBookable])
}

model AdminActionLog {
  id          String @id @default(cuid())
  adminUserId String

  // Option A: optional targets
  professionalId String?
  serviceId      String?
  categoryId     String?

  action    String
  note      String?
  createdAt DateTime @default(now())

  // Relations (named to avoid Prisma ambiguity)
  adminUser    User                 @relation("AdminUserLogs", fields: [adminUserId], references: [id])
  professional ProfessionalProfile? @relation("ProfessionalLogs", fields: [professionalId], references: [id])
  service      Service?             @relation("ServiceLogs", fields: [serviceId], references: [id])
  category     ServiceCategory?     @relation("CategoryLogs", fields: [categoryId], references: [id])

  @@index([adminUserId, createdAt])
  @@index([professionalId, createdAt])
  @@index([serviceId, createdAt])
  @@index([categoryId, createdAt])
}

model ServiceCategory {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  description      String?
  parentId         String?
  adminPermissions AdminPermission[]

  parent   ServiceCategory?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children ServiceCategory[] @relation("CategoryChildren")

  isActive Boolean @default(true)

  viralRequests   ViralServiceRequest[]
  services        Service[]
  adminActionLogs AdminActionLog[]       @relation("CategoryLogs")
  lookRankStat    LookCategoryRankStat?
  lookTrendStat   LookCategoryTrendStat?
  consultSessions ConsultSession[]
}

// Per-service-category engagement-rate aggregate — the data source for the
// per-category Bayesian prior in Look rank scoring (personalization spec §4.1:
// regress thin-evidence looks toward "typical for THIS category", not the
// global constant). One row per category with eligible looks, refreshed by the
// daily looks-category-rank-stats job and the recompute sweep script; consumed
// via lib/looks/categoryRankStats.ts.
model LookCategoryRankStat {
  categoryId         String   @id
  // Sums over eligible (published + approved) looks in the category:
  // intent-weighted engagement (the rate numerator) and floored impressions
  // (the denominator — per-look GREATEST(viewCount, raw engagement), the same
  // floor the live smoothed rate uses).
  weightedEngagement Float
  impressions        Int
  lookCount          Int
  computedAt         DateTime

  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

// Per-LOOK booking-conversion aggregate behind the Looks feed
// booking_conversion_rate term (personalization spec §4.2). Refreshed hourly by
// the look-conversion-stats job (lib/looks/conversionStats.ts) and read (batched
// by page) at feed-serve time. The spec defines the rate as
// `bookings_from_this_look / (saves + remix_clicks on this look)` — it protects
// against optimizing for "pretty content" (heavily saved, rarely booked) over
// "content that fills chairs". A look that turns interest into real bookings
// efficiently earns a small additive re-rank boost; the rankScore backbone blends
// likes/saves/comments/shares but NOT bookings, so this is genuinely new signal.
//
// Only looks with >=1 attributed non-cancelled booking get a row (the same "skip
// the zeros" rule the badge/availability stats use) — a look that has never
// driven a booking has no conversion evidence and reads as boost 0 at serve time.
// That keeps the table sparse (proportional to CONVERTING looks, not all looks).
// A stale row (job stopped) degrades gracefully — conversion is a SOFT weight.
model LookPostConversionStat {
  lookPostId String @id

  // Attributed bookings (numerator): non-cancelled bookings whose sourceLookPostId
  // is this look — a booking is a conversion whether or not the client later
  // showed up (that's a separate reliability signal). Lifetime, matching the
  // lifetime interest denominator below; the rankScore backbone already decays old
  // looks by recency, so an old high-converter isn't kept artificially hot.
  bookingCount Int @default(0)

  // Interest / exposure (denominator): saveCount + viewCount snapshot from the
  // look at refresh time — the spec's "saves + remix_clicks", with feed/detail
  // views standing in for the untracked remix-click signal. Saves must be in the
  // denominator so a heavily-saved-but-rarely-booked look scores LOW (the "pretty
  // content" case the term guards against); views add passive exposure.
  interestCount Int @default(0)

  computedAt DateTime

  lookPost LookPost @relation(fields: [lookPostId], references: [id], onDelete: Cascade)
}

// Per-family RECENT engagement-trend aggregate — the data source behind the
// engagement-driven ordering of the camera "shot packs" (camera-perfect C10;
// lib/looks/categoryTrendStats.ts → lib/pro/cameraShotPacks.ts). Sibling of
// LookCategoryRankStat: same category key, but a RECENT publish window instead
// of an all-time sum, so it answers "which service family is hot right now?"
// rather than "what rate is typical for this family?". Rows are keyed by the
// TOP-LEVEL family category (leaf categories are rolled up to their root at
// refresh time), so one row summarizes a whole family (e.g. all of "hair").
// Refreshed daily by the looks-category-trend-stats job; an empty/missing row
// reads as "no trend signal" → the shot packs fall back to their editorial
// order (byte-identical to the pre-C10 payload), so this table can only reorder
// packs, never break the camera.
model LookCategoryTrendStat {
  // Top-level (root) service category id — the family this row summarizes.
  categoryId         String   @id
  // Denormalized root slug so the serve path can read by slug in one indexed
  // query without re-walking the category tree (kept 1:1 with categoryId).
  categorySlug       String   @unique
  // Sums over eligible (published + approved) looks PUBLISHED in the trailing
  // `windowDays`, rolled up from every descendant category to this root:
  // intent-weighted engagement (the rate numerator, same weights as rank
  // scoring) and floored impressions (GREATEST(viewCount, raw engagement) — the
  // same per-look floor the live smoothed rate uses).
  weightedEngagement Float
  impressions        Int
  lookCount          Int
  // The trailing-publish window (days) this row covers — stored so the row
  // documents its own recency semantics if the config ever changes.
  windowDays         Int
  computedAt         DateTime

  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

// Per-pro live-booking aggregates behind the Looks feed badge engine
// (personalization spec §5). Refreshed hourly by the pro-badge-stats job and
// read (batched by page) at feed-serve time; a missing row reads the same as
// all-zero, so this table can never invent a badge — only earn one. computedAt
// gates time-sensitive badges (spec §5.7.4): stale stats DISQUALIFY urgency
// badges rather than render a stale "Booking fast". Consumed via
// lib/looks/badges/*.
model ProfessionalBadgeStat {
  professionalId String @id

  // Non-cancelled bookings CREATED in the trailing 48h (booking velocity —
  // the "Booking fast" urgency signal).
  recentBookingCount       Int @default(0)
  // COMPLETED bookings scheduled in the trailing 30 days (social proof).
  completedBookingCount30d Int @default(0)
  // Distinct clients with >=1 COMPLETED booking in the trailing 180 days, and
  // how many of them came back (>=2 COMPLETED in the window) — the rebook-rate
  // numerator/denominator, stored as counts so the rate math stays in code.
  servedClientCount        Int @default(0)
  rebookedClientCount      Int @default(0)
  // Booking follow-through (spec §4.2 pro_reliability). resolvedBookingCount =
  // bookings in the trailing 180 days that reached an outcome the pro is
  // accountable for — COMPLETED or CANCELLED. completedResolvedCount = the
  // COMPLETED subset. NO_SHOW is DELIBERATELY excluded from both: it is client
  // behaviour, not the pro's reliability, so it must not down-rank the pro. The
  // completion rate (completedResolvedCount / resolvedBookingCount) is
  // Bayesian-smoothed into the ranking boost, so counts live here and the rate
  // math stays in personalizedRanking.ts.
  resolvedBookingCount     Int @default(0)
  completedResolvedCount   Int @default(0)

  computedAt DateTime

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

// Per-pro calendar-availability summary behind the Looks feed availability_boost
// term (personalization spec §4.2/§4.4). Refreshed hourly by the
// pro-availability-stats job (lib/looks/availabilityStats.ts) from real working
// hours + bookings/holds/blocks — a coarse, soft ranking weight, never a hard
// filter (guardrail #8). Only pros with a real opening in the scan horizon get a
// row; a missing row reads as "no availability signal" (boost 0) at serve time,
// keeping the table proportional to bookable pros.
model ProfessionalAvailabilityStat {
  professionalId String @id

  // Start-of-local-day UTC instant of the first day within the scan horizon that
  // still has spare working-hours capacity (>= PRO_AVAILABILITY_STAT.minOpeningMinutes
  // free). Null is never stored — a pro with no opening in the horizon is dropped
  // from the table entirely — but the column is nullable so the shape stays
  // honest if that rule ever relaxes.
  nextOpeningDate DateTime?

  // Days in the next `fullnessWindowDays` (14) with spare capacity — a robust,
  // count-based openness read alongside the minute-ratio below.
  openDayCount14d Int @default(0)

  // bookedMinutes / capacityMinutes over the next 14 working days, clamped [0,1]:
  // 0 = wide open, 1 = fully booked. 0 when the window holds no working capacity.
  fullness14d Float @default(0)

  // Total working-hours capacity minutes over the next 14 days (0 = no bookable
  // schedule in the window) — lets the reader tell "wide open" from "no hours"
  // and powers observability.
  capacityMinutes14d Int @default(0)

  computedAt DateTime

  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

model ProfessionalFavorite {
  id             String   @id @default(cuid())
  professionalId String
  userId         String
  createdAt      DateTime @default(now())

  professional ProfessionalProfile @relation("ProFavorites", fields: [professionalId], references: [id])
  user         User                @relation(fields: [userId], references: [id])

