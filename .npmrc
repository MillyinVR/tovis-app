# Read by npm, which runs this repo's scripts (`npm run typecheck`, `npx vitest`).
#
# pnpm 11 reads ONLY auth and registry settings from this file (pnpm/pnpm#11189);
# everything else it takes from pnpm-workspace.yaml, where `engineStrict` is set
# to match the line below. Both must say the same thing.
#
# `package-manager-strict` used to live here. pnpm 11 removed the setting
# outright — `pmOnFail` replaced it, and its default (`download`) already gives
# the behaviour we wanted: the pinned `packageManager` version is fetched and
# used rather than whatever pnpm happens to be on PATH. So there is nothing to
# carry over, and npm never read the key.
engine-strict=true
